// Tela de primeira execução: boas-vindas + download/importação do pacote de letras.
import { ShadTheme } from "theme.slint";
import { LucideIcon } from "icons.slint";
import { ShadButton } from "components.slint";

component Feature inherits HorizontalLayout {
    in property <string> icon;
    in property <string> title;
    in property <string> text;
    spacing: 12px;
    Rectangle {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: #8b9fd822;
        border-width: 1px;
        border-color: #8b9fd844;
        LucideIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            name: root.icon;
            icon-size: 15px;
            tint: ShadTheme.live-blue-bright;
        }
    }
    VerticalLayout {
        spacing: 1px;
        alignment: center;
        Text { text: root.title; font-size: 13px; font-weight: 600; color: ShadTheme.fg; }
        Text { text: root.text; font-size: 12px; color: ShadTheme.fg-muted; wrap: word-wrap; }
    }
}

export component OnboardingScreen inherits Rectangle {
    // 0 boas-vindas, 1 baixando/importando, 2 concluído, 3 erro
    in property <int> step: 0;
    in property <float> progress: 0;      // 0..1
    in property <string> message: "";
    in property <string> detail: "";
    callback start();
    callback skip();
    callback finish();

    // Etapa do indicador (erro conta como "baixando")
    property <int> dot-step: root.step == 3 ? 1 : root.step;

    width: 100%;
    height: 100%;
    background: ShadTheme.bg;

    // Brilho suave ao fundo (marca)
    Rectangle {
        width: 640px;
        height: 640px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 - 40px;
        border-radius: 320px;
        background: @radial-gradient(circle, #8b9fd822 0%, #8b9fd800 70%);
    }

    // Impede cliques de atravessarem para a tela principal
    TouchArea {}

    Rectangle {
        width: min(560px, parent.width - 32px);
        height: card.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: ShadTheme.panel;
        border-radius: 16px;
        border-width: 1px;
        border-color: ShadTheme.border-strong;
        drop-shadow-blur: 48px;
        drop-shadow-color: #000000f0;
        drop-shadow-offset-y: 16px;

        card := VerticalLayout {
            padding-left: 36px;
            padding-right: 36px;
            padding-top: 36px;
            padding-bottom: 28px;
            spacing: 18px;

            // Ícone de estado com anel
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 76px;
                    height: 76px;
                    border-radius: 38px;
                    background: root.step == 3 ? #e5484d18 : #8b9fd81f;
                    border-width: 1px;
                    border-color: root.step == 3 ? #e5484d55 : #8b9fd855;
                    Rectangle {
                        width: 52px;
                        height: 52px;
                        x: 12px;
                        y: 12px;
                        border-radius: 26px;
                        background: root.step == 3 ? ShadTheme.destructive-bg : ShadTheme.live-blue;
                        LucideIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            name: root.step == 2 ? "check" : root.step == 3 ? "x" : root.step == 1 ? "music" : "heart";
                            icon-size: 24px;
                            tint: #ffffff;
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: 6px;
                Text {
                    text: root.step == 0 ? "Bem-vindo ao Overture"
                        : root.step == 1 ? "Preparando suas letras"
                        : root.step == 2 ? "Tudo pronto"
                        : "Não foi possível concluir";
                    font-size: 24px;
                    font-weight: 700;
                    color: ShadTheme.fg;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.step == 0 ? "Projeção de letras e Bíblia para o seu culto." : root.message;
                    font-size: 13px;
                    color: ShadTheme.fg-muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            if root.step == 0 : VerticalLayout {
                spacing: 12px;
                Rectangle { height: 1px; background: ShadTheme.border; }
                Feature { icon: "music"; title: "Coletânea de letras gospel"; text: "Milhares de músicas em português, prontas para projetar."; }
                Feature { icon: "folder"; title: "Baixada uma única vez"; text: "Precisa de internet agora; depois funciona totalmente offline."; }
                Feature { icon: "clock"; title: "Leva poucos minutos"; text: "Você pode continuar usando o Overture enquanto importa."; }
            }

            if root.step == 1 : VerticalLayout {
                spacing: 8px;
                Rectangle {
                    height: 10px;
                    border-radius: 5px;
                    background: ShadTheme.muted;
                    clip: true;
                    Rectangle {
                        x: 0px;
                        width: parent.width * clamp(root.progress, 0, 1);
                        background: @linear-gradient(90deg, #6f86cf 0%, #aabbf0 100%);
                        animate width { duration: 150ms; }
                    }
                }
                HorizontalLayout {
                    Text { horizontal-stretch: 1; text: root.detail; font-size: 11px; color: ShadTheme.fg-muted; overflow: elide; }
                    Text { text: Math.round(root.progress * 100) + "%"; font-size: 11px; font-weight: 600; color: ShadTheme.fg; }
                }
            }

            VerticalLayout {
                spacing: 8px;
                if root.step == 0 : ShadButton { label: "Baixar letras agora"; icon: "folder"; variant: "sky"; size: "md"; clicked => { root.start(); } }
                if root.step == 0 : ShadButton { label: "Pular por enquanto"; variant: "ghost"; size: "md"; clicked => { root.skip(); } }
                if root.step == 1 : ShadButton { label: "Continuar em segundo plano"; variant: "outline"; size: "md"; clicked => { root.skip(); } }
                if root.step == 2 : ShadButton { label: "Começar a usar"; variant: "sky"; size: "md"; clicked => { root.finish(); } }
                if root.step == 3 : ShadButton { label: "Tentar de novo"; variant: "sky"; size: "md"; clicked => { root.start(); } }
                if root.step == 3 : ShadButton { label: "Pular"; variant: "ghost"; size: "md"; clicked => { root.skip(); } }
            }

            // Indicador de etapas
            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                for i in 3 : Rectangle {
                    width: root.dot-step == i ? 18px : 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: root.dot-step >= i ? ShadTheme.live-blue-bright : ShadTheme.border-strong;
                    animate width { duration: 150ms; }
                }
            }
        }
    }
}

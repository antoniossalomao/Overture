// Overture Worship Projection Studio — Holyrics Workflow + Modern shadcn/ui Pure-Slint Design
import { ShadTheme, UiFocus } from "theme.slint";
import { LucideIcon } from "icons.slint";
import {
    ShadButton,
    ShadIconButton,
    ShadInput,
    ShadTextarea,
    ShadSwitch,
    ShadCheckbox,
    ShadBadge,
    ShadTabStrip,
    ShadSelect,
    ShadColSplitter,
    ShadScrollArea
} from "components.slint";
import { TopMenuTrigger, LibTab, MenuActionRow } from "chrome.slint";
import { OnboardingScreen } from "onboarding.slint";
import {
    UiBibleBookTile,
    UiBibleBookGridRow,
    UiNumberGridRow,
    UiBibleChapterVerse,
    UiBibleSearchHit,
    HolyricsBibleView
} from "bible_view.slint";
import {
    UiSlideCard,
    UiScheduleRow,
    UiReportRow,
    UiThemeRow,
    CountdownStudioModal,
    SongEditorStudioModal,
    ThemeStudioModal,
    DisplaySettingsModal,
    ScoreboardAlertModal,
    ScheduleReportsModal,
    SettingsRemoteModal
} from "modals.slint";

export {
    UiBibleBookTile,
    UiBibleBookGridRow,
    UiNumberGridRow,
    UiBibleChapterVerse,
    UiBibleSearchHit,
    UiSlideCard,
    UiScheduleRow,
    UiReportRow,
    UiThemeRow
}

export struct UiStringsData {
    app-title: string,
    go-to-bible: string,
    search-placeholder: string,
    temporary-label: string,
    themes-label: string,
    display-settings: string,
    save-theme-for-song: string,
}

export struct UiSongRow {
    song-id: int,
    title: string,
    artist: string,
    meta: string,
    has-forced-break: bool,
    duplicate-marked: bool,
    archived: bool,
}

export struct UiMediaRow {
    media-id: int,
    name: string,
    kind: string,
    path: string,
}

export struct UiPlaylistRow {
    item-id: int,
    row-idx: int,
    kind-badge: string,
    title: string,
    subtitle: string,
    is-media: bool,
}

export component MainWindow inherits Window {
    title: "Overture Studio — Projeção para Cultos";
    min-width: 920px;
    min-height: 540px;
    preferred-width: 1200px;
    preferred-height: 720px;
    background: ShadTheme.bg;
    default-font-family: "Geist";
    icon: @image-url("../../../assets/overture-512.png");

    // ==================== STATE PROPERTIES ====================
    in-out property <UiStringsData> tr: {
        app-title: "Overture",
        go-to-bible: "Ir para Bíblia",
        search-placeholder: "Pesquisar... (Ctrl+F)",
        temporary-label: "Temporário",
        themes-label: "Temas",
        display-settings: "Configurações de exibição",
        save-theme-for-song: "Salvar Tema para Música",
    };

    // Workspace Mode: 0 = Holyrics 5-Column Worship Studio, 1 = Holyrics 66-Book Bible Studio
    in-out property <int> workspace-mode: 0;
    // Active Modal: 0 = None, 1 = Countdown, 2 = SongEditor, 3 = ThemeStudio, 4 = DisplaySettings, 5 = Scoreboard/Alert, 6 = Schedule/Reports, 7 = Settings/Remote
    in-out property <int> active-modal: 0;
    in-out property <string> status-banner: "";
    // Onboarding (primeira execução): -1 oculto, 0 boas-vindas, 1 baixando, 2 pronto, 3 erro
    in-out property <int> onboarding-step: -1;
    in-out property <float> onboarding-progress: 0;
    in-out property <string> onboarding-message: "";
    in-out property <string> onboarding-detail: "";
    // Player (coluna da direita)
    in-out property <string> player-title: "";
    in-out property <float> player-pos: 0;
    in-out property <float> player-dur: 0;
    in-out property <bool> player-paused: false;
    in-out property <bool> player-active: false;
    in-out property <float> player-volume: 100;
    callback player-toggle-pause();
    callback player-stop();
    callback player-seek(float);
    callback player-volume-changed(float);
    callback player-prev();
    callback player-next();
    pure function fmt-time(t: float) -> string {
        return Math.floor(t / 60) + ":" + (Math.mod(t, 60) < 10 ? "0" : "") + Math.floor(Math.mod(t, 60));
    }
    callback onboarding-start();
    callback onboarding-skip();
    callback onboarding-finish();

    // Top Header & Active Item
    in-out property <string> active-header-title: "Selecione uma música ou versículo";
    in-out property <string> active-header-subtitle: "";
    in-out property <string> live-mode-badge: "NORMAL";
    in-out property <bool> is-black-screen: false;
    in-out property <bool> is-logo-screen: false;
    in-out property <bool> is-clear-text: false;
    in-out property <bool> auto-play-enabled: false;
    in-out property <bool> auto-play-repeat: true;
    // Tom e BPM da música ativa (vazios = só o título). Ainda sem fonte nos metadados.
    in-out property <string> active-key: "";
    // Slides marcados (um bool por slide; o app zera ao trocar de música)
    in-out property <[bool]> slide-marks: [];
    in-out property <string> active-bpm: "";

    // Column 1: Library
    in-out property <int> left-lib-tab: 0; // 0 Letras, 1 Texto, 2 Áudio, 3 Vídeo, 4 Imagem
    in-out property <string> library-search-query: "";
    property <int> search-focus-seq: 0;
    in-out property <bool> show-archived: false;
    // Escopo da busca na biblioteca
    in-out property <bool> search-in-title: true;
    in-out property <bool> search-in-artist: true;
    in-out property <bool> search-in-lyrics: true;
    in-out property <[UiSongRow]> songs-list: [];
    in-out property <int> selected-song-id: 0;
    in-out property <[UiMediaRow]> media-list: [];
    in-out property <string> quick-text-title: "Aviso";
    in-out property <string> quick-text-body: "";

    // Column 2: Active Song / Item Slides + History
    in-out property <[UiSlideCard]> active-slides: [];
    in-out property <int> current-slide-index: -1;
    in-out property <bool> slides-grid-mode: false;
    in-out property <bool> history-expanded: false;
    in-out property <[UiSongRow]> song-history-rows: [];

    // Column 3: Live Monitor Preview & Theme Binding
    in-out property <int> preview-role-tab: 0; // 0 Principal, 1 Palco, 2 Retorno
    in-out property <image> live-main-image;
    in-out property <image> live-stage-image;
    in-out property <image> live-return-image;
    in-out property <image> active-theme-thumb;
    in-out property <string> active-theme-name: "Culto Principal";
    in-out property <int> active-theme-id: 1;
    in-out property <bool> save-theme-to-song: false;
    in-out property <string> output-latency-text: "—";

    // Column 4: Playlist (Culto / Temporário) + Mídia / Anotações
    in-out property <int> col4-top-tab: 0; // 0 Mídia, 1 Anotações
    in-out property <string> operator-notes: "";
    in-out property <bool> using-temp-playlist: false;
    in-out property <string> current-service-name: "Culto Dominical";
    in-out property <[UiPlaylistRow]> playlist-song-rows: [];
    in-out property <[UiPlaylistRow]> playlist-media-rows: [];
    in-out property <int> active-playlist-row: -1;
    property <length> drag-press-y: 0px;
    property <length> drag-cur-y: 0px;

    // Column 5: Far-Right Vertical Theme Thumbnail Strip
    in-out property <bool> show-theme-strip: true;
    // A faixa de temas recolhe sozinha em janelas estreitas (< 1366 px).
    property <bool> theme-strip-visible: root.show-theme-strip && root.win-w >= 1366px;
    in-out property <int> theme-strip-filter: 0; // 0 Todos, 1 Retorno
    in-out property <[UiThemeRow]> themes-list: [];

    // Bible Studio Properties
    in-out property <string> bible-book-chapter-label: "Gênesis: 1";
    in-out property <string> bible-license-notice: "Tradução Brasileira (1917) — Domínio Público";
    in-out property <[string]> bible-version-abbrs: ["TB1917", "WEB"];
    in-out property <int> bible-version-idx: 0;
    in-out property <bool> bible-compare-on: false;
    in-out property <string> bible-compare-text: "";
    in-out property <[UiBibleBookGridRow]> bible-book-grid-rows: [];
    in-out property <[UiNumberGridRow]> bible-chapter-grid-rows: [];
    in-out property <[UiNumberGridRow]> bible-verse-grid-rows: [];
    in-out property <int> bible-active-book: 1;
    in-out property <int> bible-active-chapter: 1;
    in-out property <int> bible-active-verse: 1;
    in-out property <[UiBibleChapterVerse]> bible-chapter-verses: [];
    in-out property <[UiBibleSearchHit]> bible-search-hits: [];
    in-out property <[UiBibleSearchHit]> bible-favorite-hits: [];
    in-out property <[UiBibleSearchHit]> bible-history-hits: [];
    in-out property <string> bible-search-query: "";
    in-out property <int> bible-right-submode: 0;
    property <int> bible-search-focus-seq: 0;
    property <int> bible-search-append-seq: 0;

    // Modal Data Properties
    in-out property <image> countdown-live-preview;
    // Song Editor
    in-out property <int> editor-song-id: 0;
    in-out property <string> editor-title: "";
    in-out property <string> editor-artist: "";
    in-out property <string> editor-author: "";
    in-out property <string> editor-notes: "";
    in-out property <string> editor-raw-lyrics: "";
    in-out property <[UiSlideCard]> editor-preview-slides: [];

    // Theme Studio
    in-out property <int> theme-edit-id: 0;
    in-out property <string> theme-edit-name: "Culto Principal";
    in-out property <string> theme-font-family: "Segoe UI";
    in-out property <string> theme-font-size: "64";
    in-out property <string> theme-text-color: "#FFFFFF";
    in-out property <int> theme-bg-kind: 1;
    in-out property <string> theme-bg-primary: "#0B132B";
    in-out property <string> theme-bg-secondary: "#1C2541";
    in-out property <string> theme-bg-media: "motion://aurora";
    in-out property <bool> theme-shadow-enabled: true;
    in-out property <bool> theme-italic: false;
    in-out property <bool> theme-glow: false;
    in-out property <bool> theme-clock: false;
    in-out property <bool> theme-uppercase: false;
    in-out property <bool> theme-is-return: false;
    in-out property <int> theme-align-index: 1;
    in-out property <image> theme-live-preview;

    // Display Settings
    in-out property <[string]> monitor-options: ["Desativado"];
    in-out property <int> main-monitor-index: 0;
    in-out property <int> stage-monitor-index: 0;
    in-out property <int> return-monitor-index: 0;
    in-out property <[string]> return-theme-options: ["Retorno Palco (Alto Contraste)"];
    in-out property <int> return-theme-index: 0;
    in-out property <bool> windowed-output-mode: false;

    // Scoreboard & Stage Alert
    in-out property <string> stage-alert-text: "";
    in-out property <string> stage-timer-display: "00:00";
    in-out property <bool> scoreboard-visible: false;
    in-out property <string> team-a-name: "Equipe A";
    in-out property <string> team-b-name: "Equipe B";
    in-out property <int> team-a-score: 0;
    in-out property <int> team-b-score: 0;

    // Schedule & Reports
    in-out property <[UiScheduleRow]> schedule-rows: [];
    in-out property <[UiReportRow]> report-rows: [];
    in-out property <bool> report-by-group: false;
    in-out property <int> report-weekday-index: 0;

    // Settings & Remote
    in-out property <int> settings-locale-index: 0;
    in-out property <string> settings-api-port: "4875";
    in-out property <string> settings-api-token: "overture-local";
    in-out property <string> remote-url-hint: "http://localhost:4875";
    in-out property <string> shortcut-prev: "Left";
    in-out property <string> shortcut-next: "Right";
    in-out property <string> shortcut-black: "B";
    in-out property <string> shortcut-logo: "L";

    // Resizable column widths (tuned to Holyrics proportions so 1024px+ fits all 5 columns cleanly)
    // Proporções próximas ao Holyrics: biblioteca larga (abas inteiras), lista de slides no meio, prévia ao centro.
    // Proporções do Holyrics 2.30 (318/671/549/255/95 px em 1917 px): biblioteca 17 %,
    // slides 35 %, prévia 29 % (o resto), playlist 13 %, temas 5 %. -1px = automático
    // (proporcional à janela); o arraste dos divisores grava um valor fixo.
    // Cópia da largura da janela (evita laço de binding: root.width depende do layout).
    property <length> win-w: 1200px;
    changed width => { self.win-w = self.width; }
    property <length> col1-user: -1px;
    property <length> col2-user: -1px;
    property <length> col4-user: -1px;
    property <length> col1-width: root.col1-user >= 0px ? root.col1-user : clamp(root.win-w * 0.166, 165px, 420px);
    property <length> col2-width: root.col2-user >= 0px ? root.col2-user : clamp(root.win-w * 0.35, 215px, 700px);
    property <length> col4-width: root.col4-user >= 0px ? root.col4-user : clamp(root.win-w * 0.133, 145px, 360px);
    property <length> theme-strip-width: clamp(root.win-w * 0.05, 64px, 95px);

    // ==================== CALLBACKS ====================
    callback key-shortcut(string);

    // Transport & Modes
    callback next-slide();
    callback prev-slide();
    callback goto-slide(int);
    callback toggle-black();
    callback toggle-logo();
    callback toggle-clear-text();
    callback clear-output();
    callback toggle-auto-play(bool);
    callback toggle-auto-play-repeat(bool);

    // Library & Songs
    callback search-songs(string);
    callback search-songs-accepted(string);
    callback toggle-show-archived(bool);
    callback library-step(int);      // Alt+↑/↓: move a seleção na biblioteca
    callback song-select(int);       // Loads song into Col 2 (and records in session history)
    callback song-project-now(int);  // Loads & projects slide 0 immediately
    callback song-add-to-service(int);
    callback song-open-editor(int);
    callback song-set-archived(int, bool);
    callback deduplicate-songs();

    // Quick Text / Announcements
    callback project-quick-text(string, string);
    callback add-quick-text-to-service(string, string);

    // Media
    callback pick-and-add-media();
    callback media-project-now(int);
    callback media-add-service(int);
    callback media-remove(int);

    // Native File Dialog Actions (via pure-Rust rfd)
    callback dialog-import-txt-folder();
    callback dialog-import-pptx-or-xml();
    callback dialog-import-bible();
    callback dialog-export-txt();
    callback dialog-export-slides();
    callback create-recurring-services();
    callback dialog-export-json();
    callback dialog-create-backup();
    callback dialog-restore-backup();

    // Playlist / Culto
    callback toggle-playlist-mode(bool);
    callback create-new-service();
    callback activate-playlist-item(int);
    callback move-playlist-item(int, int);
    callback remove-playlist-item(int);
    callback save-operator-notes(string);

    // Themes
    callback apply-theme-live(int);
    callback toggle-save-theme-for-song(bool);
    callback open-theme-editor(int);
    callback pick-theme-media-file();
    callback refresh-theme-preview();
    callback save-current-theme();

    // Song Editor
    callback editor-new-song();
    callback editor-auto-split();
    callback editor-save-song();

    // Countdown, Scoreboard & Stage Alert
    callback preview-studio-countdown(string, string, string, string, int, bool, bool);
    callback start-studio-countdown(string, string, string, string, int, bool, bool);
    callback add-studio-countdown-to-service(string, string, string);
    callback stop-countdown-now();
    callback trigger-stage-alert(string);
    callback stage-timer-action(string);
    callback adjust-scoreboard(int, int, bool, string, string);

    // Bible Studio
    callback bible-select-version(int);
    callback bible-toggle-compare();
    callback bible-select-book(int);
    callback bible-select-chapter(int);
    callback bible-select-verse-project(int);
    callback bible-step-chapter(int);
    callback bible-favorite-active();
    callback bible-add-active-to-service();
    callback bible-search-edited(string);
    callback bible-search-accepted(string);
    callback bible-jump-to-hit(int, int, int);

    // Monitors, Schedule, Reports & Settings
    callback refresh-monitors();
    callback apply-monitor-outputs();
    callback close-all-outputs();
    callback add-team-schedule(string, string);
    callback remove-team-schedule(int);
    callback refresh-reports(int);
    callback change-language(int);
    callback save-app-settings();

    // ==================== GLOBAL KEYBOARD FOCUS ====================
    key-scope := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.modifiers.control && (event.text == "f" || event.text == "F")) {
                if (root.workspace-mode == 1) {
                    root.bible-search-focus-seq += 1;
                } else {
                    root.left-lib-tab = 0;
                    root.search-focus-seq += 1;
                }
                return accept;
            }
            if (event.text == Key.F2) {
                root.workspace-mode = root.workspace-mode == 0 ? 1 : 0;
                return accept;
            }
            if (event.text == Key.Escape && root.active-modal != 0) {
                root.active-modal = 0;
                return accept;
            }
            // Never steal keystrokes when user is typing inside any input / textarea!
            if (root.active-modal == 0 && UiFocus.active-inputs == 0) {
                if (event.text == Key.RightArrow || event.text == Key.DownArrow || event.text == Key.PageDown) {
                    root.next-slide();
                    return accept;
                }
                if (event.text == Key.LeftArrow || event.text == Key.UpArrow || event.text == Key.PageUp) {
                    root.prev-slide();
                    return accept;
                }
                if (root.workspace-mode == 0 && root.left-lib-tab == 0) {
                    if (event.text == Key.Return && root.selected-song-id > 0) {
                        root.song-project-now(root.selected-song-id);
                        return accept;
                    }
                    if (event.modifiers.alt && event.text == Key.UpArrow) {
                        root.library-step(-1);
                        return accept;
                    }
                    if (event.modifiers.alt && event.text == Key.DownArrow) {
                        root.library-step(1);
                        return accept;
                    }
                }
                if (root.workspace-mode == 1) {
                    if (event.text == Key.Return) {
                        root.bible-search-accepted(root.bible-search-query);
                        return accept;
                    }
                    // Holyrics instant Bible quick-locate: typing any letter/digit immediately starts locating the book+verse!
                    if (!event.modifiers.control && !event.modifiers.alt &&
                        ((event.text >= "0" && event.text <= "9") ||
                         (event.text >= "a" && event.text <= "z") ||
                         (event.text >= "A" && event.text <= "Z"))) {
                        root.bible-search-query = event.text;
                        root.bible-search-append-seq += 1;
                        root.bible-search-edited(root.bible-search-query);
                        return accept;
                    }
                } else {
                    root.key-shortcut(event.text);
                }
            }
            reject
        }

        VerticalLayout {
            spacing: 0px;

            // ==================== ROW 1: TOP STUDIO MENUBAR (26px — Holyrics + shadcn Menubar) ====================
            Rectangle {
                height: 26px;
                background: ShadTheme.bg;

                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 6px;
                    spacing: 2px;
                    alignment: space-between;

                    // Left Menus
                    HorizontalLayout {
                        spacing: 2px;
                        alignment: start;

                        // Brand Mark
                        HorizontalLayout {
                            padding-left: 4px; padding-right: 6px; spacing: 5px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 7px; height: 7px; border-radius: 3.5px;
                                    background: ShadTheme.live-blue-bright;
                                }
                            }
                            Text {
                                text: "Overture";
                                font-size: 11px;
                                font-weight: 700;
                                color: ShadTheme.fg;
                                vertical-alignment: center;
                            }
                        }

                        // Arquivo
                        Rectangle {
                            width: m-arq.width;
                            m-arq := TopMenuTrigger { label: "Arquivo"; clicked => { pop-arq.show(); } }
                            pop-arq := PopupWindow {
                                x: 0px; y: 24px; width: 255px;
                                height: arq-vbox.preferred-height + 2px;
                                Rectangle {
                                    width: 100%; height: 100%;
                                    background: ShadTheme.popover; border-radius: 6px; border-width: 1px; border-color: ShadTheme.border-strong; drop-shadow-blur: 16px; drop-shadow-color: ShadTheme.shadow-popover;
                                    arq-vbox := VerticalLayout {
                                        padding: 4px; spacing: 1px;
                                        MenuActionRow { label: "Importar Pasta de Letras (.txt)..."; icon: "folder"; triggered => { root.dialog-import-txt-folder(); } }
                                        MenuActionRow { label: "Importar PPTX / OpenSong / OpenLP..."; icon: "folder"; triggered => { root.dialog-import-pptx-or-xml(); } }
                                        MenuActionRow { label: "Importar Bíblia (Zefania / JSON)..."; icon: "book"; triggered => { root.dialog-import-bible(); } }
                                        Rectangle { height: 1px; background: ShadTheme.border; }
                                        MenuActionRow { label: "Exportar Músicas em TXT..."; icon: "share"; triggered => { root.dialog-export-txt(); } }
                                        MenuActionRow { label: "Exportar Slides do Item Atual (PNG)..."; icon: "monitor"; triggered => { root.dialog-export-slides(); } }
                                        MenuActionRow { label: "Exportar Pacote JSON..."; icon: "share"; triggered => { root.dialog-export-json(); } }
                                        Rectangle { height: 1px; background: ShadTheme.border; }
                                        MenuActionRow { label: "Criar Backup Completo (.zip)..."; icon: "folder"; triggered => { root.dialog-create-backup(); } }
                                        MenuActionRow { label: "Restaurar Backup (.zip)..."; icon: "history"; triggered => { root.dialog-restore-backup(); } }
                                        Rectangle { height: 1px; background: ShadTheme.border; }
                                        MenuActionRow { label: "Configurações..."; icon: "settings"; triggered => { root.active-modal = 7; } }
                                    }
                                }
                            }
                        }

                        // Novo
                        Rectangle {
                            width: m-novo.width;
                            m-novo := TopMenuTrigger { label: "Novo"; clicked => { pop-novo.show(); } }
                            pop-novo := PopupWindow {
                                x: 0px; y: 24px; width: 235px;
                                height: novo-vbox.preferred-height + 2px;
                                Rectangle {
                                    width: 100%; height: 100%;
                                    background: ShadTheme.popover; border-radius: 6px; border-width: 1px; border-color: ShadTheme.border-strong; drop-shadow-blur: 16px; drop-shadow-color: ShadTheme.shadow-popover;
                                    novo-vbox := VerticalLayout {
                                        padding: 4px; spacing: 1px;
                                        MenuActionRow { label: "Nova Música..."; icon: "music"; triggered => { root.editor-new-song(); root.active-modal = 2; } }
                                        MenuActionRow { label: "Novo Culto..."; icon: "list"; triggered => { root.create-new-service(); } }
                                        MenuActionRow { label: "Criar próximos 8 cultos recorrentes"; icon: "clock"; triggered => { root.create-recurring-services(); } }
                                        MenuActionRow { label: "Adicionar Mídia (Vídeo/Áudio/Img)..."; icon: "plus"; triggered => { root.pick-and-add-media(); } }
                                        MenuActionRow { label: "Nova Contagem Regressiva..."; icon: "clock"; triggered => { root.preview-studio-countdown("10", "00", "", "Para iniciar o culto", 0, true, false); root.active-modal = 1; } }
                                    }
                                }
                            }
                        }

                        // Editar
                        Rectangle {
                            width: m-ed.width;
                            m-ed := TopMenuTrigger { label: "Editar"; clicked => { pop-ed.show(); } }
                            pop-ed := PopupWindow {
                                x: 0px; y: 24px; width: 235px;
                                height: ed-vbox.preferred-height + 2px;
                                Rectangle {
                                    width: 100%; height: 100%;
                                    background: ShadTheme.popover; border-radius: 6px; border-width: 1px; border-color: ShadTheme.border-strong; drop-shadow-blur: 16px; drop-shadow-color: ShadTheme.shadow-popover;
                                    ed-vbox := VerticalLayout {
                                        padding: 4px; spacing: 1px;
                                        MenuActionRow {
                                            label: "Editar Música Selecionada...";
                                            triggered => {
                                                if (root.selected-song-id > 0) {
                                                    root.song-open-editor(root.selected-song-id);
                                                } else {
                                                    root.editor-new-song();
                                                }
                                                root.active-modal = 2;
                                            }
                                        }
                                        MenuActionRow { label: "Remover Duplicatas Exatas"; triggered => { root.deduplicate-songs(); } }
                                        MenuActionRow {
                                            label: root.show-archived ? "Ocultar Itens Arquivados" : "Mostrar Itens Arquivados";
                                            triggered => {
                                                root.show-archived = !root.show-archived;
                                                root.toggle-show-archived(root.show-archived);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Música
                        TopMenuTrigger {
                            label: "Música";
                            clicked => {
                                if (root.selected-song-id > 0) {
                                    root.song-open-editor(root.selected-song-id);
                                } else {
                                    root.editor-new-song();
                                }
                                root.active-modal = 2;
                            }
                        }

                        // Tema
                        TopMenuTrigger {
                            label: "Tema";
                            clicked => {
                                root.open-theme-editor(root.active-theme-id);
                                root.active-modal = 3;
                            }
                        }

                        // Anúncios
                        TopMenuTrigger {
                            label: "Anúncios";
                            clicked => { root.active-modal = 5; }
                        }

                        // Escala
                        TopMenuTrigger {
                            label: "Escala";
                            clicked => { root.active-modal = 6; }
                        }

                        // Relatório
                        TopMenuTrigger {
                            label: "Relatório";
                            clicked => { root.refresh-reports(root.report-weekday-index); root.active-modal = 6; }
                        }

                        // Ferramentas
                        Rectangle {
                            width: m-fer.width;
                            m-fer := TopMenuTrigger { label: "Ferramentas"; clicked => { pop-fer.show(); } }
                            pop-fer := PopupWindow {
                                x: 0px; y: 24px; width: 240px;
                                height: fer-vbox.preferred-height + 2px;
                                Rectangle {
                                    width: 100%; height: 100%;
                                    background: ShadTheme.popover; border-radius: 6px; border-width: 1px; border-color: ShadTheme.border-strong; drop-shadow-blur: 16px; drop-shadow-color: ShadTheme.shadow-popover;
                                    fer-vbox := VerticalLayout {
                                        padding: 4px; spacing: 1px;
                                        MenuActionRow { label: "Contagem Regressiva..."; triggered => { root.preview-studio-countdown("10", "00", "", "Para iniciar o culto", 0, true, false); root.active-modal = 1; } }
                                        MenuActionRow { label: "Placar Manual & Alerta de Palco..."; triggered => { root.active-modal = 5; } }
                                        MenuActionRow { label: "Backup e Exportação..."; triggered => { root.active-modal = 7; } }
                                    }
                                }
                            }
                        }

                        // Janelas
                        TopMenuTrigger {
                            label: "Janelas";
                            clicked => { root.refresh-monitors(); root.active-modal = 4; }
                        }

                        // Compartilhar
                        TopMenuTrigger {
                            label: "Compartilhar";
                            clicked => { root.active-modal = 7; }
                        }

                        // Ajuda
                        TopMenuTrigger {
                            label: "Ajuda";
                            clicked => { root.active-modal = 7; }
                        }
                    }

                    // Right Global Transport Pill + Locale (compact so zero overflow on 1024px!)
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: end;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 20px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: ShadTheme.border;
                                background: ShadTheme.muted;
                                HorizontalLayout {
                                    padding-left: 3px; padding-right: 3px; spacing: 2px;
                                    ShadIconButton {
                                        icon: "play";
                                        box-size: 18px;
                                        icon-px: 11px;
                                        active: root.auto-play-enabled;
                                        clicked => {
                                            root.auto-play-enabled = !root.auto-play-enabled;
                                            root.toggle-auto-play(root.auto-play-enabled);
                                        }
                                    }
                                    Rectangle { width: 1px; height: 12px; y: 4px; background: ShadTheme.border; }
                                    ShadIconButton {
                                        icon: "stop";
                                        box-size: 18px;
                                        icon-px: 11px;
                                        clicked => { root.clear-output(); }
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            ShadBadge {
                                text: root.live-mode-badge;
                                variant: root.is-black-screen ? "amber" : root.is-logo-screen ? "sky" : "emerald";
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            ShadButton {
                                size: "xs";
                                variant: "ghost";
                                label: root.settings-locale-index == 1 ? "EN" : "PT-BR";
                                clicked => {
                                    root.settings-locale-index = root.settings-locale-index == 1 ? 0 : 1;
                                    root.change-language(root.settings-locale-index);
                                }
                            }
                        }
                    }
                }

                Rectangle { y: parent.height - 1px; height: 1px; background: ShadTheme.border; }
            }

            // ==================== ROW 2: HOLYRICS SUB-HEADER BAR (34px) ====================
            if root.workspace-mode == 0 : Rectangle {
                height: 34px;
                background: ShadTheme.bg-bar;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;

                    // Esquerda: "Ir para Bíblia" (ícone de livro)
                    left-grp := HorizontalLayout {
                        spacing: 5px;
                        alignment: start;
                        VerticalLayout {
                            alignment: center;
                            ShadButton {
                                size: "xs";
                                icon: "book";
                                label: root.tr.go-to-bible + " (F2)";
                                variant: "secondary";
                                clicked => { root.workspace-mode = 1; }
                            }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    // Direita: grupo de alertas (mensagens) + Temporário/Culto com seta + Temas
                    right-grp := HorizontalLayout {
                        spacing: 6px;
                        alignment: end;
                        VerticalLayout {
                            alignment: center;
                            ShadIconButton {
                                icon: "message";
                                box-size: 26px;
                                clicked => { root.active-modal = 5; }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            ShadButton {
                                size: "xs";
                                variant: root.using-temp-playlist ? "sky" : "outline";
                                label: root.using-temp-playlist ? "Temporário ▾" : (root.current-service-name + " ▾");
                                clicked => {
                                    root.using-temp-playlist = !root.using-temp-playlist;
                                    root.toggle-playlist-mode(root.using-temp-playlist);
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            ShadButton {
                                size: "xs";
                                icon: "palette";
                                label: root.tr.themes-label;
                                variant: root.show-theme-strip ? "secondary" : "ghost";
                                clicked => { root.show-theme-strip = !root.show-theme-strip; }
                            }
                        }
                    }
                }

                // Título centralizado na janela; nunca passa por baixo dos botões
                Text {
                    property <length> side: max(left-grp.preferred-width, right-grp.preferred-width) + 16px;
                    x: self.side;
                    width: max(0px, parent.width - 2 * self.side);
                    height: parent.height;
                    text: root.active-header-title + (root.active-header-subtitle != "" ? "  (" + root.active-header-subtitle + ")" : "");
                    font-size: 14px;
                    font-weight: 600;
                    color: ShadTheme.fg;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                Rectangle { y: parent.height - 1px; height: 1px; background: ShadTheme.border; }
            }

            // ==================== ROW 3A: MODE 1 — HOLYRICS 66-BOOK BIBLE STUDIO ====================
            if root.workspace-mode == 1 : HolyricsBibleView {
                vertical-stretch: 1;
                current-book-chapter-label: root.bible-book-chapter-label;
                license-notice: root.bible-license-notice;
                version-abbrs: root.bible-version-abbrs;
                active-version-idx: root.bible-version-idx;
                compare-on: root.bible-compare-on;
                compare-text: root.bible-compare-text;
                toggle-compare => { root.bible-toggle-compare(); }
                book-grid-rows: root.bible-book-grid-rows;
                chapter-grid-rows: root.bible-chapter-grid-rows;
                verse-grid-rows: root.bible-verse-grid-rows;
                active-book-order: root.bible-active-book;
                active-chapter: root.bible-active-chapter;
                active-verse: root.bible-active-verse;
                chapter-verses: root.bible-chapter-verses;
                search-hits: root.bible-search-hits;
                favorite-hits: root.bible-favorite-hits;
                history-hits: root.bible-history-hits;
                search-query <=> root.bible-search-query;
                right-submode <=> root.bible-right-submode;
                search-focus-seq: root.bible-search-focus-seq;
                search-append-seq: root.bible-search-append-seq;
                live-preview-image: root.live-main-image;

                exit-bible-mode => { root.workspace-mode = 0; }
                select-version(idx) => { root.bible-select-version(idx); }
                select-book(b) => { root.bible-select-book(b); }
                select-chapter(c) => { root.bible-select-chapter(c); }
                select-verse-and-project(v) => { root.bible-select-verse-project(v); }
                step-chapter(d) => { root.bible-step-chapter(d); }
                favorite-active-verse => { root.bible-favorite-active(); }
                add-active-verse-to-service => { root.bible-add-active-to-service(); }
                search-edited(q) => { root.bible-search-edited(q); }
                search-accepted(q) => { root.bible-search-accepted(q); }
                jump-to-hit(b, c, v) => { root.bible-jump-to-hit(b, c, v); }
                open-display-settings => { root.refresh-monitors(); root.active-modal = 4; }
            }

            // ==================== ROW 3B: MODE 0 — HOLYRICS 5-COLUMN WORSHIP STUDIO ====================
            if root.workspace-mode == 0 : HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;

                // ---------- COLUMN 1: LEFT LIBRARY BROWSER ----------
                Rectangle {
                    width: root.col1-width;
                    background: ShadTheme.panel;

                    VerticalLayout {
                        spacing: 0px;

                        // Segmented Tabs: Letras | Texto | Áudio | Vídeo | Imagem
                        Rectangle {
                            height: 34px;
                            background: ShadTheme.bg-bar;
                            HorizontalLayout {
                                padding: 3px;
                                spacing: 3px;
                                HorizontalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    LibTab { horizontal-stretch: 1; compact: root.col1-width < 300px; label: "Letras"; icon: "music"; active: root.left-lib-tab == 0; clicked => { root.left-lib-tab = 0; } }
                                    LibTab { horizontal-stretch: 1; compact: root.col1-width < 300px; label: "Texto"; icon: "edit"; active: root.left-lib-tab == 1; clicked => { root.left-lib-tab = 1; } }
                                    LibTab { horizontal-stretch: 1; compact: root.col1-width < 300px; label: "Áudio"; icon: "monitor"; active: root.left-lib-tab == 2; clicked => { root.left-lib-tab = 2; } }
                                    LibTab { horizontal-stretch: 1; compact: root.col1-width < 300px; label: "Vídeo"; icon: "play"; active: root.left-lib-tab == 3; clicked => { root.left-lib-tab = 3; } }
                                    LibTab { horizontal-stretch: 1; compact: root.col1-width < 300px; label: "Img"; icon: "grid"; active: root.left-lib-tab == 4; clicked => { root.left-lib-tab = 4; } }
                                }
                                ShadIconButton {
                                    icon: "chart";
                                    tip: "Informações da biblioteca";
                                    box-size: 26px;
                                    clicked => { root.status-banner = root.songs-list.length + " itens na lista atual" + (root.show-archived ? " (com arquivados)" : ""); }
                                }
                                ShadIconButton {
                                    icon: "folder";
                                    tip: "Arquivados";
                                    box-size: 26px;
                                    active: root.show-archived;
                                    clicked => {
                                        root.show-archived = !root.show-archived;
                                        root.toggle-show-archived(root.show-archived);
                                    }
                                }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: ShadTheme.border; }
                        }

                        // Search Bar (Pesquisar... Ctrl+F)
                        if root.left-lib-tab == 0 : Rectangle {
                            height: 36px;
                            background: ShadTheme.panel;
                            HorizontalLayout {
                                padding: 4px;
                                lib-search-input := ShadInput {
                                    horizontal-stretch: 1;
                                    leading-icon: "search";
                                    placeholder: root.tr.search-placeholder;
                                    kbd-hint: "Ctrl+F";
                                    focus-seq: root.search-focus-seq;
                                    text <=> root.library-search-query;
                                    edited(q) => { root.search-songs(q); }
                                    accepted(q) => { root.search-songs-accepted(q); }
                                }
                                Rectangle {
                                    width: 24px;
                                    ShadIconButton {
                                        icon: "chevron-down";
                                        tip: "Onde buscar";
                                        box-size: 26px;
                                        y: (parent.height - self.height) / 2;
                                        clicked => { pop-scope.show(); }
                                    }
                                    pop-scope := PopupWindow {
                                        x: -150px; y: parent.height;
                                        width: 190px;
                                        height: scope-vbox.preferred-height + 2px;
                                        Rectangle {
                                            width: 100%; height: 100%;
                                            background: ShadTheme.popover; border-radius: 6px; border-width: 1px; border-color: ShadTheme.border-strong; drop-shadow-blur: 16px; drop-shadow-color: ShadTheme.shadow-popover;
                                            scope-vbox := VerticalLayout {
                                                padding: 8px; spacing: 6px;
                                                Text { text: "Buscar em"; font-size: 11px; font-weight: 600; color: ShadTheme.fg-muted; }
                                                ShadCheckbox { label: "Título"; checked <=> root.search-in-title; toggled(v) => { root.search-songs(root.library-search-query); } }
                                                ShadCheckbox { label: "Artista"; checked <=> root.search-in-artist; toggled(v) => { root.search-songs(root.library-search-query); } }
                                                ShadCheckbox { label: "Letra"; checked <=> root.search-in-lyrics; toggled(v) => { root.search-songs(root.library-search-query); } }
                                            }
                                        }
                                    }
                                }
                                ShadIconButton {
                                    icon: "plus";
                                    tip: "Nova música";
                                    box-size: 26px;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.editor-new-song(); root.active-modal = 2; }
                                }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: ShadTheme.border-subtle; }
                        }

                        // Tab 0: Dense Songs List (matching Holyrics Screenshot 1 — zero disappearing hover buttons!)
                        if root.left-lib-tab == 0 : ShadScrollArea {
                            vertical-stretch: 1;
                            content-height: songs-vbox.preferred-height + 8px;

                            songs-vbox := VerticalLayout {
                                width: parent.width;
                                spacing: 0px;

                                if root.songs-list.length == 0 : Rectangle {
                                    height: 150px;
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 8px;
                                        alignment: center;
                                        Text {
                                            text: "Nenhuma música encontrada";
                                            font-size: 12px;
                                            color: ShadTheme.fg-muted;
                                            horizontal-alignment: center;
                                        }
                                        ShadButton {
                                            icon: "folder";
                                            label: "Importar TXT...";
                                            variant: "secondary";
                                            clicked => { root.dialog-import-txt-folder(); }
                                        }
                                    }
                                }

                                for sr in root.songs-list : Rectangle {
                                    height: 30px;

                                    Rectangle {
                                        x: 6px;
                                        y: 1px;
                                        width: parent.width - 12px;
                                        height: parent.height - 2px;
                                        border-radius: ShadTheme.radius-sm;
                                        background: sr.song-id == root.selected-song-id ? ShadTheme.selected-tab-bg :
                                                    (srta.has-hover ? ShadTheme.selected-row-bg : transparent);
                                        animate background { duration: ShadTheme.motion-fast; easing: ease-out; }
                                    }

                                    // Left clickable zone selects song on click, projects immediately on double-click
                                    srta := TouchArea {
                                        x: 0px;
                                        y: 0px;
                                        width: max(24px, parent.width - 46px);
                                        height: 100%;
                                        mouse-cursor: pointer;
                                        clicked => { root.song-select(sr.song-id); }
                                        double-clicked => { root.song-project-now(sr.song-id); }
                                    }

                                    HorizontalLayout {
                                        width: 100%;
                                        height: 100%;
                                        padding-left: 14px;
                                        padding-right: 4px;
                                        spacing: 3px;
                                        Text {
                                            horizontal-stretch: 0;
                                            text: sr.title;
                                            font-size: 12px;
                                            font-weight: sr.song-id == root.selected-song-id ? 600 : 400;
                                            color: sr.song-id == root.selected-song-id ? ShadTheme.on-accent : ShadTheme.fg;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: sr.artist;
                                            font-size: 12px;
                                            color: sr.song-id == root.selected-song-id ? ShadTheme.on-accent-dim : ShadTheme.fg-muted;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }

                                        if sr.has-forced-break : VerticalLayout {
                                            alignment: center;
                                            Rectangle { width: 5px; height: 5px; border-radius: 2.5px; background: ShadTheme.amber; }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            ShadIconButton {
                                                icon: "play";
                                                box-size: 20px;
                                                icon-px: 11px;
                                                subtle: true;
                                                clicked => { root.song-project-now(sr.song-id); }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            ShadIconButton {
                                                icon: "plus";
                                                box-size: 20px;
                                                icon-px: 11px;
                                                subtle: true;
                                                clicked => { root.song-add-to-service(sr.song-id); }
                                            }
                                        }
                                    }

                                    Rectangle { y: parent.height - 1px; height: 1px; background: ShadTheme.border-subtle; }
                                }
                            }
                        }

                        // Tab 1: Quick Text / Announcement Composer
                        if root.left-lib-tab == 1 : VerticalLayout {
                            vertical-stretch: 1;
                            padding: 10px;
                            spacing: 8px;
                            Text { text: "Texto / Aviso Instantâneo"; font-size: 12px; font-weight: 600; color: ShadTheme.fg; }
                            ShadInput { text <=> root.quick-text-title; placeholder: "Título (ex: Aviso Importante)"; }
                            ShadTextarea { vertical-stretch: 1; text <=> root.quick-text-body; placeholder: "Digite o texto do slide ou separe múltiplos slides por linha em branco..."; }
                            HorizontalLayout {
                                spacing: 6px;
                                ShadButton {
                                    horizontal-stretch: 1;
                                    icon: "play";
                                    label: "Projetar";
                                    variant: "default";
                                    clicked => { root.project-quick-text(root.quick-text-title, root.quick-text-body); }
                                }
                                ShadButton {
                                    icon: "plus";
                                    label: "Ao Culto";
                                    variant: "secondary";
                                    clicked => { root.add-quick-text-to-service(root.quick-text-title, root.quick-text-body); }
                                }
                            }
                        }

                        // Tabs 2, 3, 4: Áudio / Vídeo / Imagem
                        if root.left-lib-tab >= 2 : VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 0px;
                            Rectangle {
                                height: 36px;
                                background: ShadTheme.panel;
                                HorizontalLayout {
                                    padding: 5px;
                                    ShadButton {
                                        width: 100%;
                                        icon: "folder";
                                        label: "Adicionar Mídia do Computador...";
                                        variant: "secondary";
                                        clicked => { root.pick-and-add-media(); }
                                    }
                                }
                                Rectangle { y: parent.height - 1px; height: 1px; background: ShadTheme.border-subtle; }
                            }
                            ShadScrollArea {
                                vertical-stretch: 1;
                                content-height: med-vbox.preferred-height + 8px;
                                med-vbox := VerticalLayout {
                                    width: parent.width;
                                    spacing: 0px;
                                    for mr in root.media-list : Rectangle {
                                        visible: (root.left-lib-tab == 2 && mr.kind == "AUDIO") ||
                                                 (root.left-lib-tab == 3 && mr.kind == "VIDEO") ||
                                                 (root.left-lib-tab == 4 && mr.kind == "IMAGE");
                                        height: self.visible ? 30px : 0px;
                                        background: mrta.has-hover ? ShadTheme.muted-hover : transparent;
                                        mrta := TouchArea {
                                            x: 0px;
                                            y: 0px;
                                            width: max(24px, parent.width - 48px);
                                            height: 100%;
                                            mouse-cursor: pointer;
                                            clicked => { root.media-project-now(mr.media-id); }
                                            double-clicked => { root.media-project-now(mr.media-id); }
                                        }
                                        HorizontalLayout {
                                            width: 100%;
                                            height: 100%;
                                            padding-left: 8px; padding-right: 4px; spacing: 3px;
                                            Text {
                                                horizontal-stretch: 1;
                                                text: mr.name;
                                                font-size: 11px;
                                                color: ShadTheme.fg-secondary;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            VerticalLayout { alignment: center; ShadIconButton { icon: "play"; box-size: 20px; icon-px: 11px; subtle: true; clicked => { root.media-project-now(mr.media-id); } } }
                                            VerticalLayout { alignment: center; ShadIconButton { icon: "plus"; box-size: 20px; icon-px: 11px; subtle: true; clicked => { root.media-add-service(mr.media-id); } } }
                                        }
                                        if self.visible : Rectangle { y: parent.height - 1px; height: 1px; background: ShadTheme.border-subtle; }
                                    }
                                }
                            }
                        }

                        // Bottom Library Footer Bar (matching Holyrics Screenshot 1 bottom-left)
                        Rectangle {
                            height: 26px;
                            background: ShadTheme.bg-bar;
                            Rectangle { y: 0px; height: 1px; background: ShadTheme.border; }
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px;
                                alignment: space-between;
                                Text {
                                    text: root.songs-list.length + " itens";
                                    font-size: 11px;
                                    color: ShadTheme.fg-subtle;
                                    vertical-alignment: center;
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    ShadCheckbox {
                                        label: "Arquivados";
                                        checked <=> root.show-archived;
                                        toggled(v) => { root.toggle-show-archived(v); }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        ShadIconButton {
                                            icon: "check";
                                            tip: "Projetar selecionada";
                                            box-size: 20px;
                                            icon-px: 11px;
                                            clicked => { if (root.selected-song-id > 0) { root.song-project-now(root.selected-song-id); } }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        ShadIconButton {
                                            icon: "list";
                                            tip: "Adicionar ao culto";
                                            box-size: 20px;
                                            icon-px: 11px;
                                            clicked => { if (root.selected-song-id > 0) { root.song-add-to-service(root.selected-song-id); } }
                                        }
                                    }
                                    Rectangle {
                                        width: 20px;
                                        VerticalLayout {
                                            alignment: center;
                                            ShadIconButton {
                                                icon: "settings";
                                                tip: "Mais ações";
                                                box-size: 20px;
                                                icon-px: 11px;
                                                clicked => { pop-libmenu.show(); }
                                            }
                                        }
                                        pop-libmenu := PopupWindow {
                                            x: -170px; y: -88px; width: 200px;
                                            height: lm-vbox.preferred-height + 2px;
                                            Rectangle {
                                                width: 100%; height: 100%;
                                                background: ShadTheme.popover; border-radius: 6px; border-width: 1px; border-color: ShadTheme.border-strong; drop-shadow-blur: 16px; drop-shadow-color: ShadTheme.shadow-popover;
                                                lm-vbox := VerticalLayout {
                                                    padding: 4px; spacing: 1px;
                                                    MenuActionRow { label: "Nova música..."; icon: "music"; triggered => { root.editor-new-song(); root.active-modal = 2; } }
                                                    MenuActionRow { label: "Importar pasta de letras..."; icon: "folder"; triggered => { root.dialog-import-txt-folder(); } }
                                                    MenuActionRow { label: "Adicionar mídia..."; icon: "plus"; triggered => { root.pick-and-add-media(); } }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                ShadColSplitter {
                    dragged(dx) => { root.col1-user = clamp(root.col1-width + dx, 165px, 420px); }
                }

                // ---------- COLUMN 2: CENTER-LEFT ACTIVE SONG SLIDES ----------
                Rectangle {
                    width: root.col2-width;
                    background: ShadTheme.panel;

                    VerticalLayout {
                        spacing: 0px;

                        // Slide Action Icon Toolbar (Screenshot 1 Col 2 header!)
                        Rectangle {
                            height: 34px;
                            background: ShadTheme.bg-bar;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 3px;
                                alignment: center;

                                ShadIconButton {
                                    icon: "skip-prev"; tip: "Slide anterior";
                                    box-size: 24px;
                                    clicked => { root.prev-slide(); }
                                }
                                ShadIconButton {
                                    icon: "play"; tip: "Primeiro slide";
                                    box-size: 24px;
                                    clicked => { root.goto-slide(0); }
                                }
                                ShadIconButton {
                                    icon: "skip-next"; tip: "Próximo slide";
                                    box-size: 24px;
                                    clicked => { root.next-slide(); }
                                }
                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    ShadIconButton {
                                        icon: "repeat"; tip: "Avanço automático / repetir";
                                        box-size: 24px;
                                        active: root.auto-play-enabled;
                                        clicked => { pop-repeat.show(); }
                                    }
                                    pop-repeat := PopupWindow {
                                        x: 0px; y: 26px; width: 200px;
                                        height: rep-vbox.preferred-height + 2px;
                                        Rectangle {
                                            width: 100%; height: 100%;
                                            background: ShadTheme.popover; border-radius: 6px; border-width: 1px; border-color: ShadTheme.border-strong; drop-shadow-blur: 16px; drop-shadow-color: ShadTheme.shadow-popover;
                                            rep-vbox := VerticalLayout {
                                                padding: 4px; spacing: 1px;
                                                MenuActionRow {
                                                    label: root.auto-play-enabled ? "Parar avanço automático" : "Avanço automático";
                                                    icon: "play";
                                                    triggered => {
                                                        root.auto-play-enabled = !root.auto-play-enabled;
                                                        root.toggle-auto-play(root.auto-play-enabled);
                                                    }
                                                }
                                                MenuActionRow {
                                                    label: root.auto-play-repeat ? "Parar no fim" : "Repetir";
                                                    icon: "repeat";
                                                    triggered => {
                                                        root.auto-play-repeat = !root.auto-play-repeat;
                                                        root.toggle-auto-play-repeat(root.auto-play-repeat);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                Rectangle { width: 1px; height: 14px; y: 10px; background: ShadTheme.border; }
                                ShadIconButton {
                                    icon: "palette"; tip: "Editar tema";
                                    box-size: 24px;
                                    clicked => { root.open-theme-editor(root.active-theme-id); root.active-modal = 3; }
                                }
                                ShadIconButton {
                                    icon: "edit"; tip: "Editar música";
                                    box-size: 24px;
                                    clicked => {
                                        if (root.selected-song-id > 0) {
                                            root.song-open-editor(root.selected-song-id);
                                        } else {
                                            root.editor-new-song();
                                        }
                                        root.active-modal = 2;
                                    }
                                }
                                ShadIconButton {
                                    icon: root.slides-grid-mode ? "list" : "grid"; tip: "Alternar lista/grade";
                                    box-size: 24px;
                                    active: root.slides-grid-mode;
                                    clicked => { root.slides-grid-mode = !root.slides-grid-mode; }
                                }
                                ShadIconButton {
                                    icon: "heart";
                                    tip: "Marcar slide";
                                    box-size: 24px;
                                    clicked => {
                                        if (root.current-slide-index >= 0 && root.current-slide-index < root.slide-marks.length) {
                                            root.slide-marks[root.current-slide-index] = !root.slide-marks[root.current-slide-index];
                                        }
                                    }
                                }
                                ShadIconButton {
                                    icon: "plus"; tip: "Adicionar ao culto";
                                    box-size: 24px;
                                    clicked => {
                                        if (root.selected-song-id > 0) {
                                            root.song-add-to-service(root.selected-song-id);
                                        }
                                    }
                                }
                                ShadIconButton {
                                    icon: "music"; tip: "Mostrar letras";
                                    box-size: 24px;
                                    clicked => { root.left-lib-tab = 0; }
                                }
                                ShadIconButton {
                                    icon: "trash"; tip: "Arquivar música";
                                    box-size: 24px;
                                    danger: true;
                                    clicked => {
                                        if (root.selected-song-id > 0) {
                                            root.song-set-archived(root.selected-song-id, true);
                                        } else {
                                            root.clear-output();
                                        }
                                    }
                                }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: ShadTheme.border; }
                        }

                        // Linha de tom e BPM ("Fm | BPM: 87"); some quando não há metadados
                        if root.active-key != "" || root.active-bpm != "" : Rectangle {
                            height: 24px;
                            background: ShadTheme.bg;
                            Text {
                                x: 10px; width: parent.width - 20px; height: 100%;
                                text: root.active-key + (root.active-key != "" && root.active-bpm != "" ? "  |  " : "") + (root.active-bpm != "" ? "BPM: " + root.active-bpm : "");
                                font-size: 11px;
                                font-weight: 600;
                                color: ShadTheme.fg-muted;
                                vertical-alignment: center;
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: ShadTheme.border; }
                        }

                        // Collapsible "Histórico (N)" Accordion Bar (Screenshot 1!)
                        Rectangle {
                            height: 22px;
                            background: ShadTheme.muted;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px;
                                alignment: space-between;
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Histórico (" + root.song-history-rows.length + ")";
                                    font-size: 11px;
                                    font-weight: 500;
                                    color: ShadTheme.fg-muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    LucideIcon {
                                        name: root.history-expanded ? "chevron-up" : "chevron-down";
                                        icon-size: 11px;
                                        tint: ShadTheme.fg-muted;
                                    }
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.history-expanded = !root.history-expanded; }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: ShadTheme.border; }
                        }

                        if root.history-expanded && root.song-history-rows.length > 0 : Rectangle {
                            max-height: 110px;
                            background: ShadTheme.bg;
                            ShadScrollArea {
                                width: 100%; height: 100%;
                                content-height: hist-vbox.preferred-height + 4px;
                                hist-vbox := VerticalLayout {
                                    width: parent.width;
                                    for h in root.song-history-rows : Rectangle {
                                        height: 24px;
                                        background: hta.has-hover ? ShadTheme.accent : transparent;
                                        Text {
                                            x: 10px; width: parent.width - 20px; height: 100%;
                                            text: h.title + (h.artist != "" ? " (" + h.artist + ")" : "");
                                            font-size: 11px; color: ShadTheme.fg-muted; vertical-alignment: center; overflow: elide;
                                        }
                                        hta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.song-select(h.song-id); root.history-expanded = false; }
                                        }
                                    }
                                }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: ShadTheme.border; }
                        }

                        // Vertical 2-Line Slide Rows (Screenshot 1 signature view!)
                        ShadScrollArea {
                            vertical-stretch: 1;
                            content-height: slides-vbox.preferred-height + 12px;

                            slides-vbox := VerticalLayout {
                                alignment: start;
                                width: parent.width;
                                spacing: root.slides-grid-mode ? 6px : 2px;
                                padding: root.slides-grid-mode ? 8px : 6px;

                                for sc in root.active-slides : Rectangle {
                                    min-height: max(28px, sl-row-layout.preferred-height);
                                    border-radius: ShadTheme.radius-sm;
                                    border-width: root.slides-grid-mode && sc.slide-idx == root.current-slide-index ? 1px : 0px;
                                    border-color: ShadTheme.live-blue-bright;
                                    background: sc.slide-idx == root.current-slide-index ? ShadTheme.live-row-bg :
                                                (slta.has-hover ? ShadTheme.muted-hover : (root.slides-grid-mode ? ShadTheme.card : transparent));
                                    animate background { duration: ShadTheme.motion-fast; easing: ease-out; }

                                    sl-row-layout := HorizontalLayout {
                                        width: 100%;
                                        padding-left: 10px;
                                        padding-right: 8px;
                                        padding-top: 3px;
                                        padding-bottom: 3px;
                                        spacing: 8px;

                                        Text {
                                            width: 16px;
                                            text: sc.number-label;
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: sc.slide-idx == root.current-slide-index ? #ffffffcc : ShadTheme.fg-muted;
                                            vertical-alignment: top;
                                            horizontal-alignment: right;
                                        }

                                        Text {
                                            horizontal-stretch: 1;
                                            text: sc.body;
                                            font-size: 12px;
                                            font-weight: sc.slide-idx == root.current-slide-index ? 600 : 400;
                                            color: sc.slide-idx == root.current-slide-index ? ShadTheme.on-accent : ShadTheme.fg-secondary;
                                            vertical-alignment: center;
                                            wrap: word-wrap;
                                        }

                                        if sc.slide-idx < root.slide-marks.length && root.slide-marks[sc.slide-idx] : VerticalLayout {
                                            alignment: center;
                                            LucideIcon { name: "heart-fill"; icon-size: 12px; tint: ShadTheme.destructive; }
                                        }

                                        if sc.forced-break : VerticalLayout {
                                            alignment: center;
                                            ShadBadge { text: "revisar"; variant: "amber"; }
                                        }

                                        if sc.slide-idx == root.current-slide-index : VerticalLayout {
                                            alignment: center;
                                            LucideIcon { name: "check"; icon-size: 14px; tint: ShadTheme.on-accent; }
                                        }
                                    }

                                    if !root.slides-grid-mode : Rectangle {
                                        y: parent.height - 1px;
                                        width: 100%;
                                        height: 1px;
                                        background: ShadTheme.border-subtle;
                                    }

                                    slta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.goto-slide(sc.slide-idx); }
                                    }
                                }
                            }
                        }
                    }
                }

                ShadColSplitter {
                    dragged(dx) => { root.col2-user = clamp(root.col2-width + dx, 215px, 700px); }
                }

                // ---------- COLUMN 3: CENTER LIVE MONITOR PREVIEW ----------
                Rectangle {
                    horizontal-stretch: 1;
                    background: ShadTheme.bg;

                    VerticalLayout {
                        spacing: 0px;

                        // Painel Player: faixa atual, tempo, transporte, volume e saída
                        Rectangle {
                            height: 74px;
                            background: ShadTheme.panel;
                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                spacing: 5px;

                                HorizontalLayout {
                                    spacing: 6px;
                                    LucideIcon { name: "music"; icon-size: 12px; tint: root.player-active ? ShadTheme.live-blue-bright : ShadTheme.fg-muted; }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.player-active ? root.player-title : "Player — nenhuma faixa";
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: root.player-active ? ShadTheme.fg : ShadTheme.fg-muted;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.fmt-time(root.player-pos) + " / " + root.fmt-time(root.player-dur);
                                        font-size: 11px;
                                        color: ShadTheme.fg-muted;
                                        vertical-alignment: center;
                                    }
                                }

                                // Barra de progresso (clique para buscar)
                                Rectangle {
                                    height: 8px;
                                    border-radius: 4px;
                                    background: ShadTheme.muted;
                                    clip: true;
                                    Rectangle {
                                        x: 0px;
                                        width: root.player-dur > 0 ? parent.width * clamp(root.player-pos / root.player-dur, 0, 1) : 0px;
                                        background: ShadTheme.live-blue-bright;
                                    }
                                    TouchArea {
                                        enabled: root.player-active && root.player-dur > 0;
                                        mouse-cursor: pointer;
                                        clicked => { root.player-seek(self.mouse-x / self.width * root.player-dur); }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 3px;
                                    ShadIconButton { icon: "skip-prev"; box-size: 24px; clicked => { root.player-prev(); } }
                                    ShadIconButton { icon: root.player-paused || !root.player-active ? "play" : "pause"; box-size: 24px; active: root.player-active && !root.player-paused; clicked => { root.player-toggle-pause(); } }
                                    ShadIconButton { icon: "skip-next"; box-size: 24px; clicked => { root.player-next(); } }
                                    ShadIconButton { icon: "stop"; box-size: 24px; clicked => { root.player-stop(); } }
                                    Rectangle { horizontal-stretch: 1; }
                                    VerticalLayout {
                                        alignment: center;
                                        LucideIcon { name: "monitor"; icon-size: 13px; tint: ShadTheme.fg-muted; }
                                    }
                                    // Volume (clique para ajustar)
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 70px;
                                            height: 6px;
                                            border-radius: 3px;
                                            background: ShadTheme.muted;
                                            clip: true;
                                            Rectangle {
                                                x: 0px;
                                                width: parent.width * clamp(root.player-volume / 100, 0, 1);
                                                background: ShadTheme.fg-secondary;
                                            }
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.player-volume-changed(self.mouse-x / self.width * 100); }
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: ShadTheme.border; }
                        }

                        // Top Engine / Role Header (like Holyrics "VLC Player" bar, upgraded!)
                        Rectangle {
                            height: 28px;
                            background: ShadTheme.bg-bar;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                alignment: space-between;

                                Text {
                                    horizontal-stretch: 1;
                                    text: "wgpu DX12";
                                    font-size: 11px;
                                    color: ShadTheme.fg-muted;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    ShadTabStrip {
                                        width: 174px;
                                        height: 22px;
                                        tabs: ["Principal", "Palco", "Retorno"];
                                        active-index <=> root.preview-role-tab;
                                    }
                                }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: ShadTheme.border; }
                        }

                        // Center 16:9 Live Output Monitor Stage
                        Rectangle {
                            vertical-stretch: 1;
                            background: ShadTheme.bg;

                            // 16:9 Aspect-Locked Monitor Bezel
                            Rectangle {
                                property <length> max-w: max(80px, parent.width - 16px);
                                property <length> max-h: max(45px, parent.height - 16px);
                                width: min(self.max-w, self.max-h * 16 / 9);
                                height: self.width * 9 / 16;
                                x: (parent.width - self.width) / 2;
                                y: 8px;
                                background: ShadTheme.stage;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: ShadTheme.border-strong;
                                drop-shadow-blur: 20px;
                                drop-shadow-color: #000000aa;
                                clip: true;

                                Image {
                                    width: 100%;
                                    height: 100%;
                                    image-fit: contain;
                                    source: root.preview-role-tab == 1 ? root.live-stage-image :
                                            root.preview-role-tab == 2 ? root.live-return-image : root.live-main-image;
                                }
                            }
                        }

                        // Quick Live Transport & Blackout Pill Bar (compact so 270px+ never clips!)
                        Rectangle {
                            height: 32px;
                            background: ShadTheme.bg;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 4px;
                                alignment: center;

                                ShadIconButton { icon: "chevron-left"; box-size: 24px; clicked => { root.prev-slide(); } }
                                ShadIconButton { icon: "chevron-right"; box-size: 24px; active: true; clicked => { root.next-slide(); } }
                                ShadButton { size: "xs"; label: "Preta"; variant: "secondary"; active: root.is-black-screen; clicked => { root.toggle-black(); } }
                                ShadButton { size: "xs"; label: "S/ Texto"; variant: "secondary"; active: root.is-clear-text; clicked => { root.toggle-clear-text(); } }
                                ShadButton { size: "xs"; label: "Logo"; variant: "secondary"; active: root.is-logo-screen; clicked => { root.toggle-logo(); } }
                                ShadIconButton { icon: "clock"; box-size: 24px; clicked => { root.preview-studio-countdown("10", "00", "", "Para iniciar o culto", 0, true, false); root.active-modal = 1; } }
                                ShadIconButton { icon: "trophy"; box-size: 24px; clicked => { root.active-modal = 5; } }
                            }
                        }

                        // Bottom Bar: Salvar Tema para Música + Mini Theme Card + Configurações de exibição (Screenshot 1!)
                        Rectangle {
                            height: 44px;
                            background: ShadTheme.bg-bar;
                            Rectangle { y: 0px; height: 1px; background: ShadTheme.border; }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                alignment: center;

                                VerticalLayout {
                                    alignment: center;
                                    ShadSwitch {
                                        label: "Salvar Tema";
                                        checked <=> root.save-theme-to-song;
                                        toggled(v) => { root.toggle-save-theme-for-song(v); }
                                    }
                                }

                                // Active Theme Mini Thumbnail Box
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 52px;
                                        height: 29px;
                                        border-radius: 4px;
                                        border-width: 1px;
                                        border-color: ShadTheme.border-strong;
                                        background: ShadTheme.stage;
                                        clip: true;
                                        Image { width: 100%; height: 100%; image-fit: cover; source: root.active-theme-thumb; }
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.open-theme-editor(root.active-theme-id); root.active-modal = 3; }
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    ShadButton {
                                        size: "xs";
                                        icon: "monitor";
                                        label: "Exibição";
                                        variant: "secondary";
                                        clicked => { root.refresh-monitors(); root.active-modal = 4; }
                                    }
                                }
                            }
                        }
                    }
                }

                ShadColSplitter {
                    dragged(dx) => { root.col4-user = clamp(root.col4-width - dx, 145px, 360px); }
                }

                // ---------- COLUMN 4: MÍDIA / ANOTAÇÕES + ORDEM DO CULTO ----------
                Rectangle {
                    width: root.col4-width;
                    background: ShadTheme.panel;

                    VerticalLayout {
                        spacing: 0px;

                        // Top Tabs: Mídia | Anotações (Screenshot 1 Col 4 top!)
                        Rectangle {
                            height: 34px;
                            background: ShadTheme.bg-bar;
                            HorizontalLayout {
                                padding: 3px;
                                ShadTabStrip {
                                    horizontal-stretch: 1;
                                    tabs: ["Mídia", "Anotações"];
                                    active-index <=> root.col4-top-tab;
                                }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: ShadTheme.border; }
                        }

                        // Top Pane Body (Mídia items in service OR Operator Notes)
                        Rectangle {
                            height: 138px;
                            background: ShadTheme.panel;

                            if root.col4-top-tab == 0 : VerticalLayout {
                                spacing: 0px;
                                ShadScrollArea {
                                    vertical-stretch: 1;
                                    content-height: pm-vbox.preferred-height + 6px;
                                    pm-vbox := VerticalLayout {
                                        width: parent.width;
                                        for pm in root.playlist-media-rows : Rectangle {
                                            height: 30px;
                                            background: pm.row-idx == root.active-playlist-row ? ShadTheme.live-row-bg :
                                                        (pmta.has-hover ? ShadTheme.muted-hover : transparent);
                                            pmta := TouchArea {
                                                x: 0px;
                                                y: 0px;
                                                width: max(20px, parent.width - 26px);
                                                height: 100%;
                                                mouse-cursor: pointer;
                                                clicked => { root.activate-playlist-item(pm.row-idx); }
                                            }
                                            HorizontalLayout {
                                                width: 100%;
                                                height: 100%;
                                                padding-left: 8px; padding-right: 4px; spacing: 4px;
                                                Text { horizontal-stretch: 1; text: pm.title; font-size: 11px; color: ShadTheme.fg; vertical-alignment: center; overflow: elide; }
                                                VerticalLayout { alignment: center; ShadIconButton { icon: "x"; box-size: 18px; icon-px: 11px; subtle: true; danger: true; clicked => { root.remove-playlist-item(pm.row-idx); } } }
                                            }
                                            Rectangle { y: parent.height - 1px; height: 1px; background: ShadTheme.border-subtle; }
                                        }
                                    }
                                }
                                Rectangle {
                                    height: 26px;
                                    background: ShadTheme.bg-bar;
                                    HorizontalLayout {
                                        padding: 2px; spacing: 3px; alignment: center;
                                        ShadButton { size: "xs"; label: "+ Cont."; variant: "ghost"; clicked => { root.preview-studio-countdown("10", "00", "", "Para iniciar o culto", 0, true, false); root.active-modal = 1; } }
                                        ShadButton { size: "xs"; label: "+ Mídia"; variant: "ghost"; clicked => { root.pick-and-add-media(); } }
                                    }
                                }
                            }

                            if root.col4-top-tab == 1 : VerticalLayout {
                                padding: 5px;
                                ShadTextarea {
                                    vertical-stretch: 1;
                                    text <=> root.operator-notes;
                                    placeholder: "Anotações do culto / avisos internos...";
                                    edited(txt) => { root.save-operator-notes(txt); }
                                }
                            }

                            Rectangle { y: parent.height - 1px; height: 1px; background: ShadTheme.border; }
                        }

                        // "Letras" (Ordem do Culto / Playlist) Header (Screenshot 1 Col 4 middle!)
                        Rectangle {
                            height: 28px;
                            background: ShadTheme.bg-bar;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 6px;
                                alignment: space-between;
                                HorizontalLayout {
                                    spacing: 5px;
                                    VerticalLayout { alignment: center; LucideIcon { name: "list"; icon-size: 12px; tint: ShadTheme.fg-muted; } }
                                    Text {
                                        text: root.using-temp-playlist ? "Temporário" : "Letras (Culto)";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: ShadTheme.fg;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    ShadIconButton {
                                        icon: "plus";
                                        box-size: 20px;
                                        icon-px: 12px;
                                        clicked => { root.create-new-service(); }
                                    }
                                }
                            }
                            Rectangle { y: parent.height - 1px; height: 1px; background: ShadTheme.border; }
                        }

                        // Stacked Centered Playlist Cards (exact Holyrics Screenshot 1 style — zero disappearing buttons!)
                        ShadScrollArea {
                            vertical-stretch: 1;
                            content-height: pl-vbox.preferred-height + 8px;

                            pl-vbox := VerticalLayout {
                                width: parent.width;
                                spacing: 0px;
                                for pl in root.playlist-song-rows : Rectangle {
                                    height: 44px;
                                    background: pl.row-idx == root.active-playlist-row ? ShadTheme.live-row-bg :
                                                (plta.has-hover ? ShadTheme.muted-hover : transparent);

                                    if pl.row-idx == root.active-playlist-row : Rectangle {
                                        x: 0px; y: 0px; width: 3px; height: 100%;
                                        background: ShadTheme.live-blue-bright;
                                    }

                                    plta := TouchArea {
                                        x: 0px;
                                        y: 0px;
                                        width: max(24px, parent.width - 54px);
                                        height: 100%;
                                        mouse-cursor: pointer;
                                        // Clique (pouca distância) projeta; arrastar para cima/baixo reordena.
                                        pointer-event(ev) => {
                                            if (ev.kind == PointerEventKind.down) {
                                                root.drag-press-y = self.mouse-y;
                                                root.drag-cur-y = self.mouse-y;
                                            }
                                        }
                                        moved => { root.drag-cur-y = self.mouse-y; }
                                        clicked => {
                                            if (abs(root.drag-cur-y - root.drag-press-y) < 6px) {
                                                root.activate-playlist-item(pl.row-idx);
                                            } else {
                                                root.move-playlist-item(pl.row-idx, round((root.drag-cur-y - root.drag-press-y) / 44px));
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        width: 100%;
                                        height: 100%;
                                        padding-left: 7px;
                                        padding-right: 3px;
                                        spacing: 2px;

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 1px;
                                            Text {
                                                text: pl.title;
                                                font-size: 11px;
                                                font-weight: pl.row-idx == root.active-playlist-row ? 600 : 500;
                                                color: pl.row-idx == root.active-playlist-row ? ShadTheme.on-accent : ShadTheme.fg;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: pl.subtitle != "" ? pl.subtitle : pl.kind-badge;
                                                font-size: 11px;
                                                color: ShadTheme.fg-muted;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 0px;
                                            alignment: center;
                                            VerticalLayout {
                                                alignment: center;
                                                ShadIconButton { icon: "chevron-up"; box-size: 17px; icon-px: 10px; subtle: true; clicked => { root.move-playlist-item(pl.row-idx, -1); } }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                ShadIconButton { icon: "chevron-down"; box-size: 17px; icon-px: 10px; subtle: true; clicked => { root.move-playlist-item(pl.row-idx, 1); } }
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                ShadIconButton { icon: "x"; box-size: 17px; icon-px: 10px; subtle: true; danger: true; clicked => { root.remove-playlist-item(pl.row-idx); } }
                                            }
                                        }
                                    }

                                    Rectangle { y: parent.height - 1px; height: 1px; background: ShadTheme.border-subtle; }
                                }
                            }
                        }
                    }
                }

                // ---------- COLUMN 5: FAR-RIGHT VERTICAL THEME THUMBNAIL STRIP (Screenshot 1!) ----------
                if root.theme-strip-visible : Rectangle {
                    width: 1px;
                    background: ShadTheme.border;
                }

                if root.theme-strip-visible : Rectangle {
                    width: root.theme-strip-width;
                    background: ShadTheme.bg-bar;

                    VerticalLayout {
                        spacing: 0px;

                        ShadScrollArea {
                            vertical-stretch: 1;
                            content-height: tstrip-vbox.preferred-height + 8px;

                            tstrip-vbox := VerticalLayout {
                                width: parent.width;
                                padding: 4px;
                                spacing: 4px;

                                for th in root.themes-list : Rectangle {
                                    visible: root.theme-strip-filter == 0 || (root.theme-strip-filter == 1 && th.is-return);
                                    height: self.visible ? 42px : 0px;
                                    border-radius: 4px;
                                    border-width: th.theme-id == root.active-theme-id ? 2px : 1px;
                                    border-color: th.theme-id == root.active-theme-id ? ShadTheme.live-blue-bright :
                                                  (thta.has-hover ? ShadTheme.fg-muted : ShadTheme.border);
                                    background: ShadTheme.stage;
                                    clip: true;

                                    Image {
                                        width: 100%;
                                        height: 100%;
                                        image-fit: cover;
                                        source: th.thumbnail;
                                    }

                                    // Subtle bottom name overlay on hover
                                    if thta.has-hover : Rectangle {
                                        y: parent.height - 14px;
                                        height: 14px;
                                        background: #000000cc;
                                        Text {
                                            x: 2px; width: parent.width - 4px; height: 100%;
                                            text: th.name;
                                            font-size: 11px;
                                            color: ShadTheme.on-accent;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }

                                    thta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.apply-theme-live(th.theme-id); }
                                        double-clicked => { root.open-theme-editor(th.theme-id); root.active-modal = 3; }
                                    }
                                }

                                // + New Theme button at bottom of strip
                                ShadButton {
                                    size: "xs";
                                    icon: "plus";
                                    label: "Novo";
                                    variant: "outline";
                                    clicked => {
                                        root.theme-edit-id = 0;
                                        root.theme-edit-name = "Novo Tema";
                                        root.refresh-theme-preview();
                                        root.active-modal = 3;
                                    }
                                }
                            }
                        }

                        // Bottom Filter ("Todos | Ret." like Holyrics Screenshot 1)
                        Rectangle {
                            height: 26px;
                            background: ShadTheme.bg;
                            Rectangle { y: 0px; height: 1px; background: ShadTheme.border; }
                            HorizontalLayout {
                                padding: 2px;
                                ShadTabStrip {
                                    height: 22px;
                                    tabs: ["Todos", "Ret."];
                                    active-index <=> root.theme-strip-filter;
                                }
                            }
                        }
                    }
                }
            }

            // ==================== ROW 4: DEDICATED STUDIO STATUS BAR (20px — zero header collisions!) ====================
            Rectangle {
                height: 20px;
                background: ShadTheme.bg;
                Rectangle { y: 0px; height: 1px; background: ShadTheme.border; }
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 10px;
                    alignment: space-between;

                    Text {
                        text: "Overture v0.1.1 • Rust Puro (Skia + DirectX 12)";
                        font-size: 11px;
                        color: ShadTheme.fg-subtle;
                        vertical-alignment: center;
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.status-banner;
                        font-size: 11px;
                        color: ShadTheme.live-blue-bright;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Text {
                        text: "Saída GPU: " + root.output-latency-text;
                        font-size: 11px;
                        color: ShadTheme.fg-subtle;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ==================== MODAL OVERLAYS ====================
        if root.active-modal == 1 : CountdownStudioModal {
            countdown-live-preview: root.countdown-live-preview;
            close => { root.active-modal = 0; }
            preview-changed(m, s, bef, aft, mode, pad, hide0) => { root.preview-studio-countdown(m, s, bef, aft, mode, pad, hide0); }
            start-countdown(m, s, bef, aft, mode, pad, hide0) => { root.start-studio-countdown(m, s, bef, aft, mode, pad, hide0); }
            add-countdown-to-service(m, s, aft) => { root.add-studio-countdown-to-service(m, s, aft); }
            stop-countdown => { root.stop-countdown-now(); }
        }

        if root.active-modal == 2 : SongEditorStudioModal {
            song-id <=> root.editor-song-id;
            song-title <=> root.editor-title;
            song-artist <=> root.editor-artist;
            song-author <=> root.editor-author;
            song-notes <=> root.editor-notes;
            raw-lyrics <=> root.editor-raw-lyrics;
            preview-slides: root.editor-preview-slides;
            close => { root.active-modal = 0; }
            new-blank-song => { root.editor-new-song(); }
            auto-split => { root.editor-auto-split(); }
            save-song => { root.editor-save-song(); }
        }

        if root.active-modal == 3 : ThemeStudioModal {
            themes-list: root.themes-list;
            edit-id <=> root.theme-edit-id;
            edit-name <=> root.theme-edit-name;
            edit-font-family <=> root.theme-font-family;
            edit-font-size <=> root.theme-font-size;
            edit-text-color <=> root.theme-text-color;
            edit-bg-kind <=> root.theme-bg-kind;
            edit-bg-primary <=> root.theme-bg-primary;
            edit-bg-secondary <=> root.theme-bg-secondary;
            edit-bg-media <=> root.theme-bg-media;
            edit-shadow <=> root.theme-shadow-enabled;
            edit-italic <=> root.theme-italic;
            edit-glow <=> root.theme-glow;
            edit-clock <=> root.theme-clock;
            edit-uppercase <=> root.theme-uppercase;
            edit-is-return <=> root.theme-is-return;
            edit-align <=> root.theme-align-index;
            theme-preview-image: root.theme-live-preview;
            close => { root.active-modal = 0; }
            select-theme-for-edit(tid) => { root.open-theme-editor(tid); }
            pick-theme-media-file => { root.pick-theme-media-file(); }
            refresh-preview => { root.refresh-theme-preview(); }
            save-theme => { root.save-current-theme(); }
        }

        if root.active-modal == 4 : DisplaySettingsModal {
            monitor-options: root.monitor-options;
            main-monitor-idx <=> root.main-monitor-index;
            stage-monitor-idx <=> root.stage-monitor-index;
            return-monitor-idx <=> root.return-monitor-index;
            return-theme-options: root.return-theme-options;
            return-theme-idx <=> root.return-theme-index;
            windowed-output-mode <=> root.windowed-output-mode;
            latency-text: root.output-latency-text;
            close => { root.active-modal = 0; }
            refresh-monitors => { root.refresh-monitors(); }
            apply-outputs => { root.apply-monitor-outputs(); }
            close-all-outputs => { root.close-all-outputs(); }
        }

        if root.active-modal == 5 : ScoreboardAlertModal {
            stage-alert-text <=> root.stage-alert-text;
            stage-timer-display: root.stage-timer-display;
            scoreboard-visible <=> root.scoreboard-visible;
            team-a-name <=> root.team-a-name;
            team-b-name <=> root.team-b-name;
            team-a-score: root.team-a-score;
            team-b-score: root.team-b-score;
            close => { root.active-modal = 0; }
            send-stage-alert(msg) => { root.trigger-stage-alert(msg); }
            stage-timer-cmd(act) => { root.stage-timer-action(act); }
            adjust-score(da, db, vis, na, nb) => { root.adjust-scoreboard(da, db, vis, na, nb); }
        }

        if root.active-modal == 6 : ScheduleReportsModal {
            schedule-rows: root.schedule-rows;
            report-rows: root.report-rows;
            report-by-group <=> root.report-by-group;
            weekday-idx <=> root.report-weekday-index;
            close => { root.active-modal = 0; }
            add-schedule(m, r) => { root.add-team-schedule(m, r); }
            remove-schedule(id) => { root.remove-team-schedule(id); }
            filter-weekday(idx) => { root.refresh-reports(idx); }
        }

        if root.active-modal == 7 : SettingsRemoteModal {
            locale-idx <=> root.settings-locale-index;
            api-port <=> root.settings-api-port;
            api-token <=> root.settings-api-token;
            remote-lan-url: root.remote-url-hint;
            shortcut-prev <=> root.shortcut-prev;
            shortcut-next <=> root.shortcut-next;
            shortcut-black <=> root.shortcut-black;
            shortcut-logo <=> root.shortcut-logo;
            close => { root.active-modal = 0; }
            change-locale(idx) => { root.change-language(idx); }
            save-settings => { root.save-app-settings(); }
            trigger-backup-dialog => { root.dialog-create-backup(); }
            trigger-restore-dialog => { root.dialog-restore-backup(); }
            trigger-export-txt-dialog => { root.dialog-export-txt(); }
            trigger-export-json-dialog => { root.dialog-export-json(); }
        }
    }

    if root.onboarding-step >= 0 : OnboardingScreen {
        step: root.onboarding-step;
        progress: root.onboarding-progress;
        message: root.onboarding-message;
        detail: root.onboarding-detail;
        start => { root.onboarding-start(); }
        skip => { root.onboarding-skip(); }
        finish => { root.onboarding-finish(); }
    }
}

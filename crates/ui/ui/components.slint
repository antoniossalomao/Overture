// Genuine shadcn/ui Component Kit built from GPU primitives in 100% Pure Slint
import { ShadTheme, UiFocus } from "theme.slint";
import { LucideIcon } from "icons.slint";

export component ShadBadge inherits Rectangle {
    in property <string> text;
    in property <string> variant: "secondary"; // "default" | "secondary" | "outline" | "sky" | "amber" | "emerald"

    height: 18px;
    border-radius: 9px;
    border-width: 1px;
    background: root.variant == "default" ? ShadTheme.primary :
                root.variant == "sky" ? #0a84ff26 :
                root.variant == "amber" ? ShadTheme.amber-bg :
                root.variant == "emerald" ? ShadTheme.emerald-bg :
                root.variant == "outline" ? transparent : ShadTheme.muted;
    border-color: root.variant == "default" ? ShadTheme.primary :
                  root.variant == "sky" ? #0a84ff59 :
                  root.variant == "amber" ? ShadTheme.amber-border :
                  root.variant == "emerald" ? ShadTheme.emerald-border : ShadTheme.border;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        Text {
            text: root.text;
            font-size: 10px;
            font-weight: 600;
            vertical-alignment: center;
            color: root.variant == "default" ? ShadTheme.primary-fg :
                   root.variant == "sky" ? ShadTheme.live-blue-bright :
                   root.variant == "amber" ? ShadTheme.amber :
                   root.variant == "emerald" ? ShadTheme.emerald : ShadTheme.fg-muted;
        }
    }
}

export component ShadButton inherits Rectangle {
    in property <string> label: "";
    in property <string> icon: "";
    in property <string> variant: "secondary"; // "default" | "secondary" | "outline" | "ghost" | "destructive" | "sky"
    in property <string> size: "sm";           // "xs" | "sm" | "md"
    in property <bool> active: false;
    in property <bool> disabled: false;
    callback clicked();

    height: root.size == "xs" ? 24px : root.size == "md" ? 34px : 28px;
    border-radius: ShadTheme.radius-sm;
    border-width: (root.variant == "outline" || root.variant == "destructive") ? 1px : 0px;
    border-color: root.variant == "destructive" ? ShadTheme.destructive-border :
                  root.variant == "outline" ? ShadTheme.border-strong : ShadTheme.border;

    background: root.disabled ? ShadTheme.muted :
                root.active ? ShadTheme.live-blue :
                root.variant == "default" ? (ta.pressed ? ShadTheme.primary-pressed : ta.has-hover ? ShadTheme.primary-hover : ShadTheme.primary) :
                root.variant == "sky" ? (ta.pressed ? ShadTheme.sky-pressed : ta.has-hover ? ShadTheme.live-blue-hover : ShadTheme.live-blue) :
                root.variant == "destructive" ? (ta.has-hover ? ShadTheme.destructive-hover : ShadTheme.destructive-bg) :
                root.variant == "outline" ? (ta.has-hover ? ShadTheme.accent : transparent) :
                root.variant == "ghost" ? (ta.has-hover ? ShadTheme.accent : transparent) :
                (ta.pressed ? ShadTheme.accent-pressed : ta.has-hover ? ShadTheme.accent-hover : ShadTheme.accent);

    animate background { duration: ShadTheme.motion-fast; easing: ease-out; }

    HorizontalLayout {
        padding-left: root.size == "xs" ? 7px : 10px;
        padding-right: root.size == "xs" ? 7px : 10px;
        spacing: 6px;
        alignment: center;

        if root.icon != "" : VerticalLayout {
            alignment: center;
            LucideIcon {
                name: root.icon;
                icon-size: root.size == "xs" ? 12px : 13px;
                tint: (root.variant == "default" || root.variant == "sky" || root.active) ? ShadTheme.on-accent :
                      root.variant == "destructive" ? ShadTheme.destructive : ShadTheme.fg;
            }
        }
        if root.label != "" : Text {
            text: root.label;
            font-size: root.size == "xs" ? 11px : 12px;
            font-weight: 500;
            vertical-alignment: center;
            color: root.disabled ? ShadTheme.fg-subtle :
                   (root.variant == "default" || root.variant == "sky" || root.active) ? ShadTheme.on-accent :
                   root.variant == "destructive" ? ShadTheme.destructive : ShadTheme.fg;
        }
    }

    ta := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: root.disabled ? default : pointer;
        clicked => { root.clicked(); }
    }
}

export component ShadIconButton inherits Rectangle {
    in property <string> icon: "play";
    in property <bool> active: false;
    in property <bool> danger: false;
    in property <bool> subtle: false;
    in property <length> box-size: 26px;
    in property <length> icon-px: 13px;
    in property <string> tip: "";
    callback clicked();

    width: root.box-size;
    height: root.box-size;
    border-radius: ShadTheme.radius-xs;
    border-width: root.active ? 1px : 0px;
    border-color: ShadTheme.live-blue-bright;
    background: root.active ? ShadTheme.live-blue :
                ta.pressed ? ShadTheme.accent-hover :
                ta.has-hover ? (root.danger ? ShadTheme.destructive-bg : ShadTheme.accent) : transparent;
    animate background { duration: 100ms; }

    LucideIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        name: root.icon;
        icon-size: root.icon-px;
        tint: root.active ? ShadTheme.on-accent :
              root.danger && ta.has-hover ? ShadTheme.destructive :
              ta.has-hover ? ShadTheme.fg :
              root.subtle ? ShadTheme.fg-subtle : ShadTheme.fg-muted;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // Tooltip simples sob o ícone
    if root.tip != "" && ta.has-hover : Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height + 4px;
        width: tip-txt.preferred-width + 14px;
        height: 22px;
        background: ShadTheme.popover;
        border-radius: 4px;
        border-width: 1px;
        border-color: ShadTheme.border-strong;
        drop-shadow-blur: 8px;
        drop-shadow-color: #000000aa;
        tip-txt := Text {
            text: root.tip;
            font-size: 11px;
            color: ShadTheme.fg;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

export component ShadInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <string> leading-icon: "";
    in property <string> kbd-hint: "";
    in property <bool> show-clear: leading-icon == "search";
    in property <int> focus-seq: 0;
    in property <int> append-focus-seq: 0;
    callback edited(string);
    callback accepted(string);

    property <bool> tracked-focus: ti.has-focus;
    changed tracked-focus => {
        UiFocus.active-inputs = max(0, UiFocus.active-inputs + (self.tracked-focus ? 1 : -1));
    }

    changed focus-seq => {
        if (root.focus-seq > 0) {
            ti.focus();
            ti.select-all();
        }
    }

    changed append-focus-seq => {
        if (root.append-focus-seq > 0) {
            ti.focus();
            ti.set-selection-offsets(10000, 10000);
        }
    }

    public function focus-input() {
        ti.focus();
        ti.select-all();
    }

    public function focus-end() {
        ti.focus();
        ti.set-selection-offsets(10000, 10000);
    }

    height: 28px;
    border-radius: ShadTheme.radius-sm;
    border-width: 1px;
    border-color: ti.has-focus ? ShadTheme.live-blue-bright : ShadTheme.border;
    background: ShadTheme.bg;
    animate border-color { duration: 120ms; }

    HorizontalLayout {
        height: 100%;
        padding-left: 8px;
        padding-right: 6px;
        spacing: 5px;

        if root.leading-icon != "" : VerticalLayout {
            alignment: center;
            LucideIcon {
                name: root.leading-icon;
                icon-size: 13px;
                tint: ti.has-focus ? ShadTheme.live-blue-bright : ShadTheme.fg-subtle;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 100%;
            clip: true;

            if root.text == "" : Text {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                text: root.placeholder;
                color: ShadTheme.fg-subtle;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }

            ti := TextInput {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                text <=> root.text;
                color: ShadTheme.fg;
                font-size: 12px;
                vertical-alignment: center;
                single-line: true;
                selection-background-color: ShadTheme.live-blue;
                selection-foreground-color: ShadTheme.on-accent;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
        }

        if root.show-clear && root.text != "" : VerticalLayout {
            alignment: center;
            ShadIconButton {
                icon: "x";
                box-size: 18px;
                icon-px: 11px;
                clicked => {
                    root.text = "";
                    root.edited("");
                }
            }
        }

        if root.text == "" && root.kbd-hint != "" : VerticalLayout {
            alignment: center;
            Rectangle {
                height: 17px;
                border-radius: 3px;
                border-width: 1px;
                border-color: ShadTheme.border;
                background: ShadTheme.muted;
                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    Text {
                        text: root.kbd-hint;
                        font-size: 11px;
                        color: ShadTheme.fg-subtle;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component ShadTextarea inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    callback edited(string);

    property <bool> tracked-focus: ti.has-focus;
    changed tracked-focus => {
        UiFocus.active-inputs = max(0, UiFocus.active-inputs + (self.tracked-focus ? 1 : -1));
    }

    border-radius: ShadTheme.radius-md;
    border-width: 1px;
    border-color: ti.has-focus ? ShadTheme.live-blue-bright : ShadTheme.border;
    background: ShadTheme.bg;
    clip: true;

    Flickable {
        x: 8px;
        y: 6px;
        width: parent.width - 16px;
        height: parent.height - 12px;
        content-width: self.width;
        content-height: max(self.height, ti.preferred-height + 16px);

        if root.text == "" : Text {
            x: 0px; y: 0px;
            width: parent.width;
            text: root.placeholder;
            color: ShadTheme.fg-subtle;
            font-size: 12px;
            wrap: word-wrap;
        }

        ti := TextInput {
            x: 0px; y: 0px;
            width: parent.width;
            text <=> root.text;
            color: ShadTheme.fg;
            font-size: 12px;
            single-line: false;
            wrap: word-wrap;
            selection-background-color: ShadTheme.live-blue;
            selection-foreground-color: ShadTheme.on-accent;
            edited => { root.edited(self.text); }
        }
    }
}

export component ShadSwitch inherits HorizontalLayout {
    in-out property <bool> checked: false;
    in property <string> label: "";
    callback toggled(bool);

    spacing: 7px;
    alignment: start;

    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 36px;
            height: 20px;
            border-radius: 10px;
            background: root.checked ? ShadTheme.emerald : ShadTheme.accent;
            animate background { duration: 140ms; }

            Rectangle {
                x: root.checked ? 18px : 2px;
                y: 2px;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: ShadTheme.on-accent;
                drop-shadow-blur: 3px;
                drop-shadow-offset-y: 1px;
                drop-shadow-color: #00000066;
                animate x { duration: 140ms; easing: ease-out; }
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.checked = !root.checked;
                    root.toggled(root.checked);
                }
            }
        }
    }

    if root.label != "" : VerticalLayout {
        alignment: center;
        Text {
            text: root.label;
            font-size: 11px;
            color: ShadTheme.fg-muted;
            vertical-alignment: center;
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.checked = !root.checked;
                    root.toggled(root.checked);
                }
            }
        }
    }
}

export component ShadCheckbox inherits HorizontalLayout {
    in-out property <bool> checked: false;
    in property <string> label: "";
    callback toggled(bool);

    spacing: 6px;
    alignment: start;

    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 15px;
            height: 15px;
            border-radius: 3px;
            border-width: 1px;
            border-color: root.checked ? ShadTheme.live-blue-bright : ShadTheme.border-strong;
            background: root.checked ? ShadTheme.live-blue : ShadTheme.bg;

            if root.checked : LucideIcon {
                x: 1px; y: 1px;
                name: "check";
                icon-size: 11px;
                tint: #ffffff;
            }

            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.checked = !root.checked;
                    root.toggled(root.checked);
                }
            }
        }
    }

    if root.label != "" : VerticalLayout {
        alignment: center;
        Text {
            text: root.label;
            font-size: 12px;
            color: ShadTheme.fg-secondary;
            vertical-alignment: center;
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.checked = !root.checked;
                    root.toggled(root.checked);
                }
            }
        }
    }
}

export component ShadTabStrip inherits Rectangle {
    in property <[string]> tabs: [];
    in-out property <int> active-index: 0;
    callback changed(int);

    height: 26px;
    background: ShadTheme.bg-bar;
    border-radius: ShadTheme.radius-sm;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for tab-label[idx] in root.tabs : Rectangle {
            horizontal-stretch: 1;
            border-radius: 4px;
            background: root.active-index == idx ? ShadTheme.selected-tab-bg : (tta.has-hover ? ShadTheme.muted-hover : transparent);
            drop-shadow-blur: root.active-index == idx ? 1px : 0px;
            drop-shadow-offset-y: 1px;
            drop-shadow-color: #00000055;
            animate background { duration: 100ms; }

            Text {
                text: tab-label;
                font-size: 11px;
                font-weight: root.active-index == idx ? 600 : 500;
                color: root.active-index == idx ? ShadTheme.fg : ShadTheme.fg-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }

            tta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.active-index = idx;
                    root.changed(idx);
                }
            }
        }
    }
}

export component ShadSelect inherits Rectangle {
    in property <[string]> model: [];
    in-out property <int> current-index: 0;
    in property <string> current-value: "";
    callback selected(int);

    height: 28px;
    border-radius: ShadTheme.radius-sm;
    border-width: 1px;
    border-color: ta.has-hover ? ShadTheme.border-strong : ShadTheme.border;
    background: ShadTheme.bg;

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 7px;
        spacing: 6px;
        Text {
            horizontal-stretch: 1;
            text: root.current-value != "" ? root.current-value :
                  (root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "—");
            font-size: 12px;
            color: ShadTheme.fg;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            LucideIcon {
                name: "chevron-down";
                icon-size: 12px;
                tint: ShadTheme.fg-muted;
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 3px;
        width: max(root.width, 190px);
        height: pop-vbox.preferred-height + 2px;

        Rectangle {
            width: 100%;
            height: 100%;
            background: ShadTheme.popover;
            border-radius: ShadTheme.radius-md;
            border-width: 1px;
            border-color: ShadTheme.border-strong;
            drop-shadow-blur: 16px;
            drop-shadow-color: ShadTheme.shadow-popover;

            pop-vbox := VerticalLayout {
                padding: 4px;
                spacing: 1px;
                for item[idx] in root.model : Rectangle {
                    height: 26px;
                    border-radius: 4px;
                    background: ita.has-hover ? ShadTheme.accent :
                                (idx == root.current-index ? ShadTheme.muted : transparent);
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        Text {
                            horizontal-stretch: 1;
                            text: item;
                            font-size: 12px;
                            color: ShadTheme.fg;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if idx == root.current-index : VerticalLayout {
                            alignment: center;
                            LucideIcon { name: "check"; icon-size: 12px; tint: ShadTheme.live-blue-bright; }
                        }
                    }
                    ita := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-index = idx;
                            root.selected(idx);
                        }
                    }
                }
            }
        }
    }
}

export component ShadColSplitter inherits Rectangle {
    callback dragged(length);

    width: 5px;
    background: transparent;

    Rectangle {
        x: (parent.width - self.width) / 2;
        width: ta.pressed || ta.has-hover ? 2px : 1px;
        background: ta.pressed ? ShadTheme.live-blue :
                    ta.has-hover ? ShadTheme.border-strong : ShadTheme.border;
        animate background, width { duration: ShadTheme.motion-fast; easing: ease-out; }
    }

    ta := TouchArea {
        mouse-cursor: col-resize;
        moved => {
            if (self.pressed) {
                root.dragged(self.mouse-x - self.pressed-x);
            }
        }
    }
}

export component ShadScrollArea inherits Rectangle {
    in property <length> content-height: 100px;
    background: transparent;
    clip: true;

    public function scroll-to-ratio(ratio: float) {
        if (root.content-height > root.height) {
            flick.content-y = -clamp(ratio, 0.0, 1.0) * (root.content-height - root.height);
        } else {
            flick.content-y = 0px;
        }
    }

    flick := Flickable {
        width: 100%;
        height: 100%;
        content-height: max(self.height, root.content-height);
        @children
    }

    // Ultra-clean shadcn scrollbar thumb
    if root.content-height > root.height : Rectangle {
        x: parent.width - 6px;
        y: 2px + (parent.height - 4px - self.height) * (-flick.content-y / max(1px, root.content-height - root.height));
        width: 4px;
        height: max(24px, (parent.height - 4px) * (root.height / max(1px, root.content-height)));
        border-radius: 2px;
        background: #ffffff33;
    }
}

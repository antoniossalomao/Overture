// shadcn/ui Zinc Dark + Holyrics Studio Design System Tokens (100% Pure Slint)

export global ShadTheme {
    // Core Surfaces (Zinc 950 -> Zinc 800)
    out property <color> bg: #09090b;
    out property <color> bg-bar: #0c0c0f;
    out property <color> panel: #101014;
    out property <color> card: #131318;
    out property <color> popover: #0c0c10;
    out property <color> muted: #18181b;
    out property <color> muted-hover: #212126;
    out property <color> accent: #27272a;
    out property <color> accent-hover: #34343a;

    // Borders & Focus Rings
    out property <color> border: #27272a;
    out property <color> border-subtle: #1d1d22;
    out property <color> border-strong: #3f3f46;
    out property <color> ring: #71717a;

    // Typography
    out property <color> fg: #fafafa;
    out property <color> fg-secondary: #e4e4e7;
    out property <color> fg-muted: #a1a1aa;
    out property <color> fg-subtle: #71717a;

    // Brand / Primary (shadcn high-contrast + Holyrics Live Blue)
    out property <color> primary: #fafafa;
    out property <color> primary-hover: #e4e4e7;
    out property <color> primary-fg: #09090b;

    out property <color> live-blue: #0284c7;
    out property <color> live-blue-hover: #0369a1;
    out property <color> live-blue-bright: #38bdf8;
    out property <color> live-row-bg: #164e78;
    out property <color> selected-row-bg: #1e293b;

    // Semantic Status
    out property <color> emerald: #10b981;
    out property <color> emerald-bg: #052e16;
    out property <color> emerald-border: #065f46;

    out property <color> amber: #f59e0b;
    out property <color> amber-bg: #451a03;
    out property <color> amber-border: #92400e;

    out property <color> destructive: #ef4444;
    out property <color> destructive-bg: #450a0a;
    out property <color> destructive-hover: #7f1d1d;
    out property <color> destructive-border: #991b1b;

    // Radii (shadcn/ui radius = 0.375rem / 6px)
    out property <length> radius-xs: 4px;
    out property <length> radius-sm: 5px;
    out property <length> radius-md: 6px;
    out property <length> radius-lg: 8px;

    // Holyrics 66-Book Canonical Palette (Modernized saturation)
    public pure function bible-book-bg(cat: int, active: bool, hovered: bool) -> color {
        if (active) { return #0284c7; }
        if (cat == 0) { return hovered ? #57381c : #432a14; } // Pentateuch
        if (cat == 1) { return hovered ? #cf7d1d : #b86b14; } // Historical
        if (cat == 2) { return hovered ? #c42525 : #a81c1c; } // Poetic
        if (cat == 3) { return hovered ? #863696 : #6e297c; } // Prophets
        if (cat == 4) { return hovered ? #2560b8 : #1c4c96; } // Gospels
        if (cat == 5) { return hovered ? #1298ba : #0d7f9c; } // Acts
        if (cat == 6) { return hovered ? #16945b : #107a49; } // Epistles
        return hovered ? #78b81d : #649c16;                   // Revelation
    }

    public pure function bible-book-border(cat: int, active: bool) -> color {
        if (active) { return #7dd3fc; }
        if (cat == 0) { return #664222; }
        if (cat == 1) { return #db8c32; }
        if (cat == 2) { return #cf3a3a; }
        if (cat == 3) { return #9342a3; }
        if (cat == 4) { return #356ec4; }
        if (cat == 5) { return #27a7c4; }
        if (cat == 6) { return #24a369; }
        return #88c92e;
    }
}

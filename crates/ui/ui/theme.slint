// Overture design tokens — tema escuro neutro (grafite), alinhado ao Orion (Grafite escuro)
import "../fonts/geist-sans-latin-400-normal.ttf";
import "../fonts/geist-sans-latin-500-normal.ttf";
import "../fonts/geist-sans-latin-600-normal.ttf";
import "../fonts/geist-mono-latin-400-normal.ttf";
import "../fonts/geist-mono-latin-500-normal.ttf";

export global UiFocus {
    in-out property <int> active-inputs: 0;
}

export global ShadTheme {
    // Core Surfaces (Zinc 950 -> Zinc 800)
    out property <color> bg: #151618;
    out property <color> bg-bar: #111214;
    out property <color> panel: #1b1c1f;
    out property <color> card: #1b1c1f;
    out property <color> popover: #1b1c1f;
    out property <color> muted: #1e1f22;
    out property <color> muted-hover: #222327;
    out property <color> accent: #26272b;
    out property <color> accent-hover: #2e2f34;

    // Borders & Focus Rings
    out property <color> border: #ffffff1c;
    out property <color> border-subtle: #ffffff10;
    out property <color> border-strong: #ffffff33;
    out property <color> ring: #a4b3de;

    // Typography
    out property <color> fg: #ececee;
    out property <color> fg-secondary: #c9cacf;
    out property <color> fg-muted: #a9aab0;
    out property <color> fg-subtle: #8e8f96;

    // Brand / Primary (shadcn high-contrast + Holyrics Live Blue)
    out property <color> primary: #b9c6ea;
    out property <color> primary-hover: #c8d3f0;
    out property <color> primary-fg: #0f1320;

    out property <color> live-blue: #a4b3de;
    out property <color> live-blue-hover: #b4c2e6;
    out property <color> live-blue-bright: #b9c6ea;
    out property <color> live-row-bg: #272b3a;
    out property <color> selected-row-bg: #26272b;

    // Semantic Status
    out property <color> emerald: #74cfae;
    out property <color> emerald-bg: #17271f;
    out property <color> emerald-border: #2f5a48;

    out property <color> amber: #e9b467;
    out property <color> amber-bg: #2a2116;
    out property <color> amber-border: #6b4e1e;

    out property <color> destructive: #f07c88;
    out property <color> destructive-bg: #2e1a1d;
    out property <color> destructive-hover: #4a2528;
    out property <color> destructive-border: #6b2e35;

    // Overlays, elevação e texto sobre superfícies saturadas
    out property <color> on-accent: #ffffff;
    out property <color> on-accent-dim: #ffffffcc;
    out property <color> stage: #000000;
    out property <color> scrim: #000000b8;
    out property <color> shadow-popover: #000000bb;
    out property <color> shadow-modal: #000000dd;
    out property <color> selected-tab-bg: #26304a;
    out property <color> primary-pressed: #d6d8de;
    out property <color> sky-pressed: #8fa0d0;
    out property <color> accent-pressed: #34363c;

    // Movimento
    out property <duration> motion-fast: 120ms;

    // Radii (shadcn/ui radius = 0.375rem / 6px)
    out property <length> radius-xs: 4px;
    out property <length> radius-sm: 6px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 12px;

    // Holyrics 66-Book Canonical Palette (Modernized saturation)
    public pure function bible-book-bg(cat: int, active: bool, hovered: bool) -> color {
        if (active) { return #2b3350; }
        if (cat == 0) { return hovered ? #5a483b : #4a3a30; } // Pentateuco
        if (cat == 1) { return hovered ? #6b5a36 : #5a4a2e; } // Históricos
        if (cat == 2) { return hovered ? #6b3f3f : #5a3434; } // Poéticos
        if (cat == 3) { return hovered ? #524870 : #443a5c; } // Profetas
        if (cat == 4) { return hovered ? #3b4d6e : #2f3f5c; } // Evangelhos
        if (cat == 5) { return hovered ? #3b6064 : #2f4f52; } // Atos
        if (cat == 6) { return hovered ? #3b6450 : #2f5140; } // Epístolas
        return hovered ? #5a6440 : #4a5230;                   // Apocalipse
    }

    public pure function bible-book-border(cat: int, active: bool) -> color {
        if (active) { return #a4b3de; }
        if (cat == 0) { return #5e4b3e; }
        if (cat == 1) { return #6e5c36; }
        if (cat == 2) { return #6e4444; }
        if (cat == 3) { return #5a4d78; }
        if (cat == 4) { return #3f5378; }
        if (cat == 5) { return #3f6a6e; }
        if (cat == 6) { return #3f6b55; }
        return #5c6a42;
    }
}

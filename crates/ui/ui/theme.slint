// Overture design tokens — escuro neutro estilo macOS (Sequoia): superfícies em camadas, azul de sistema, divisórias de 1px translúcidas
import "../fonts/geist-sans-latin-400-normal.ttf";
import "../fonts/geist-sans-latin-500-normal.ttf";
import "../fonts/geist-sans-latin-600-normal.ttf";
import "../fonts/geist-mono-latin-400-normal.ttf";
import "../fonts/geist-mono-latin-500-normal.ttf";

export global UiFocus {
    in-out property <int> active-inputs: 0;
}

export global ShadTheme {
    // Core Surfaces 
    out property <color> bg: #1e1e20;
    out property <color> bg-bar: #28282a;
    out property <color> panel: #232325;
    out property <color> card: #262628;
    out property <color> popover: #2c2c2e;
    out property <color> muted: #2a2a2c;
    out property <color> muted-hover: #323235;
    out property <color> accent: #38383b;
    out property <color> accent-hover: #444447;

    // Borders & Focus Rings
    out property <color> border: #ffffff1a;
    out property <color> border-subtle: #ffffff0f;
    out property <color> border-strong: #ffffff29;
    out property <color> ring: #0a84ff99;

    // Typography
    out property <color> fg: #f2f2f4;
    out property <color> fg-secondary: #d2d2d6;
    out property <color> fg-muted: #a4a4aa;
    out property <color> fg-subtle: #7f7f86;

    // Brand / Primary (shadcn high-contrast + Holyrics Live Blue)
    out property <color> primary: #0a84ff;
    out property <color> primary-hover: #2b97ff;
    out property <color> primary-fg: #ffffff;

    out property <color> live-blue: #0a84ff;
    out property <color> live-blue-hover: #2b97ff;
    out property <color> live-blue-bright: #64acff;
    out property <color> live-row-bg: #0a84ff33;
    out property <color> selected-row-bg: #ffffff14;

    // Semantic Status
    out property <color> emerald: #32d74b;
    out property <color> emerald-bg: #32d74b22;
    out property <color> emerald-border: #32d74b55;

    out property <color> amber: #ffb340;
    out property <color> amber-bg: #ffb34022;
    out property <color> amber-border: #ffb34055;

    out property <color> destructive: #ff6961;
    out property <color> destructive-bg: #ff453a26;
    out property <color> destructive-hover: #ff453a40;
    out property <color> destructive-border: #ff453a55;

    // Overlays, elevação e texto sobre superfícies saturadas
    out property <color> on-accent: #ffffff;
    out property <color> on-accent-dim: #ffffffcc;
    out property <color> stage: #000000;
    out property <color> scrim: #000000b8;
    out property <color> shadow-popover: #000000bb;
    out property <color> shadow-modal: #000000dd;
    out property <color> selected-tab-bg: #0a84ff;
    out property <color> primary-pressed: #0070e0;
    out property <color> sky-pressed: #0070e0;
    out property <color> accent-pressed: #4e4e52;

    // Movimento
    out property <duration> motion-fast: 120ms;

    // Radii (shadcn/ui radius = 0.375rem / 6px)
    out property <length> radius-xs: 5px;
    out property <length> radius-sm: 6px;
    out property <length> radius-md: 10px;
    out property <length> radius-lg: 14px;

    // Holyrics 66-Book Canonical Palette (Modernized saturation)
    public pure function bible-book-bg(cat: int, active: bool, hovered: bool) -> color {
        if (active) { return #2b3350; }
        if (cat == 0) { return hovered ? #5a483b : #4a3a30; } // Pentateuco
        if (cat == 1) { return hovered ? #6b5a36 : #5a4a2e; } // Históricos
        if (cat == 2) { return hovered ? #6b3f3f : #5a3434; } // Poéticos
        if (cat == 3) { return hovered ? #524870 : #443a5c; } // Profetas
        if (cat == 4) { return hovered ? #3b4d6e : #2f3f5c; } // Evangelhos
        if (cat == 5) { return hovered ? #3b6064 : #2f4f52; } // Atos
        if (cat == 6) { return hovered ? #3b6450 : #2f5140; } // Epístolas
        return hovered ? #5a6440 : #4a5230;                   // Apocalipse
    }

    public pure function bible-book-border(cat: int, active: bool) -> color {
        if (active) { return #a4b3de; }
        if (cat == 0) { return #5e4b3e; }
        if (cat == 1) { return #6e5c36; }
        if (cat == 2) { return #6e4444; }
        if (cat == 3) { return #5a4d78; }
        if (cat == 4) { return #3f5378; }
        if (cat == 5) { return #3f6a6e; }
        if (cat == 6) { return #3f6b55; }
        return #5c6a42;
    }
}
